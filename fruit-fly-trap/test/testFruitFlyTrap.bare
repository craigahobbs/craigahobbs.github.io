            142, \
            204.3253200185464, \
            'M 6.00000000 5.00000000 A 130.00000000 130.00000000 0.00000000 0 1 120.08573305 198.32532002 ' + \
                'L 23.55165124 145.58851077 A 20.00000000 20.00000000 0.00000000 0 0 6.00000000 115.00000000 Z', \
            'M 26.00000000 136.00000000 L 136.00000000 136.00000000' \
        ) \
    ])
endfunction
unittestRunTest('testFruitFlyTrapConeFormQuadrant2')


