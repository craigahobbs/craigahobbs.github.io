function testLifeClickWidthHeight():
    life = testLifeCells(10, 10, [[1, 1]])
    args = testLifeArgs({'play': false, 'initRatio': 0})
    testLifeMockAll()
    lifeClickWidthHeight(life, args, 5, 0)
    lifeClickWidthHeight(life, args, -5, 0)
    lifeClickWidthHeight(life, args, 0, 5)
    unittestDeepEqual(unittestMockEnd(), [ \
        ['sessionStorageSet', ['life', jsonStringify(testLifeCellsEncoded(15, 10, []))]], \
        testLifeMenuRenderPause, \
        testLifeBoardRender(316, 211, 0, 'white', 'forestgreen', [], true), \
        # The width is at least 10
        ['sessionStorageSet', ['life', jsonStringify(testLifeCellsEncoded(10, 10, []))]], \
        testLifeMenuRenderPause, \
        testLifeBoardRender(211, 211, 0, 'white', 'forestgreen', [], true), \
        ['sessionStorageSet', ['life', jsonStringify(testLifeCellsEncoded(10, 15, []))]], \
        testLifeMenuRenderPause, \
        testLifeBoardRender(141, 211, 0, 'white', 'forestgreen', [], true) \
    ])
endfunction
unittestRunTest('testLifeClickWidthHeight')


function testLifeClickCell():
    life = testLifeCells(10, 10, [])
    args = testLifeArgs({'play': false})
    testLifeMockAll()

    # Toggle on (2, 1)
    lifeClickCell(life, args, 50, 30)
    unittestDeepEqual(testLifePoints(life), [[2, 1]])

    # Toggle off (2, 1)
    lifeClickCell(life, args, 50, 30)
    unittestDeepEqual(testLifePoints(life), [])

    # Clicks outside the board toggle the nearest edge cell
    lifeClickCell(life, args, -10, 1000)
    unittestDeepEqual(testLifePoints(life), [[0, 9]])

    unittestDeepEqual(unittestMockEnd(), [ \
        ['sessionStorageSet', ['life', jsonStringify(testLifeCells(10, 10, [[2, 1]]))]], \
        testLifeMenuRenderPause, \
        testLifeBoardRender(211, 211, 0, 'white', 'forestgreen', [[43, 22, 20]], true), \
        ['sessionStorageSet', ['life', jsonStringify(testLifeCells(10, 10, []))]], \
        testLifeMenuRenderPause, \
        testLifeBoardRender(211, 211, 0, 'white', 'forestgreen', [], true), \
        ['sessionStorageSet', ['life', jsonStringify(testLifeCells(10, 10, [[0, 9]]))]], \
        testLifeMenuRenderPause, \
        testLifeBoardRender(211, 211, 0, 'white', 'forestgreen', [[1, 190, 20]], true) \
    ])
endfunction
unittestRunTest('testLifeClickCell')


function testLifeClickCellBorder():
    # With a 5-pixel border, the cells are 19 pixels with a 20-pixel pitch starting at 6 - without the border
    # offset, this click would toggle (4, 2)
    life = testLifeCells(10, 10, [])
    testLifeMockAll()
    lifeClickCell(life, testLifeArgs({'play': false, 'border': 5}), 82, 42)
    unittestMockEnd()
    unittestDeepEqual(testLifePoints(life), [[3, 1]])
endfunction
unittestRunTest('testLifeClickCellBorder')


function testLifeClickCellBinding():
    life = testLifeCells(10, 10, [[1, 1]])
    lifeJSON = jsonStringify(life)
    args = testLifeArgs({'play': false})
    testLifeMockAll()
    lifeRender(life, args)
    boardCall = arrayGet(unittestMockEnd(), 1)
    svg = objectGet(arrayGet(arrayGet(boardCall, 1), 0), 'elem')
    clickFn = objectGet(objectGet(svg, 'callback'), 'click')

    # MarkdownUp appends the click point and the SVG size
    testSameEffect(systemPartial(clickFn, 50, 30, 211, 211), systemPartial(lifeClickCell, jsonParse(lifeJSON), args, 50, 30))
endfunction
unittestRunTest('testLifeClickCellBinding')


