function testLifeSetTimeout():
    life = testLifeCells(10, 10, [])
    args = testLifeArgs()
    testLifeMockAll()
    lifeSetTimeout(life, args)
    lifeSetTimeout(life, args, 100)
    lifeSetTimeout(life, args, 2000)
    lifeSetTimeout(life, testLifeArgs({'rate': 8}))
    lifeSetTimeout(life, testLifeArgs({'play': false}))
    unittestDeepEqual(unittestMockEnd(), [ \
        ['windowSetTimeout', ['<function>', 500]], \
        ['windowSetTimeout', ['<function>', 400]], \
        ['windowSetTimeout', ['<function>', 0]], \
        ['windowSetTimeout', ['<function>', 1000 / 30]] \
    ])
endfunction
unittestRunTest('testLifeSetTimeout')


function testLifeSetTimeoutBinding():
    life = testLifeCells(10, 10, [[1, 0], [2, 1], [0, 2], [1, 2], [2, 2]])
    lifeJSON = jsonStringify(life)
    args = testLifeArgs()
    testLifeMockAll()
    lifeSetTimeout(life, args)
    timeoutCall = arrayGet(unittestMockEnd(), 0)
    testSameEffect(arrayGet(arrayGet(timeoutCall, 1), 0), systemPartial(lifeTimeout, jsonParse(lifeJSON), args))
endfunction
unittestRunTest('testLifeSetTimeoutBinding')


#
# lifeTimeout tests
#


function testLifeTimeout():
    # A glider - no cycle
    life = testLifeCells(10, 10, [[1, 0], [2, 1], [0, 2], [1, 2], [2, 2]])
    nextLife = testLifeCells(10, 10, [[0, 1], [2, 1], [1, 2], [2, 2], [1, 3]])
    testLifeMockAll()
    lifeTimeout(life, testLifeArgs())
    unittestDeepEqual(unittestMockEnd(), [ \
        ['sessionStorageSet', ['life', jsonStringify(nextLife)]], \
        ['documentSetReset', ['lifeReset']], \
        testLifeBoardRender(211, 211, 0, 'white', 'forestgreen', \
            [[1, 22, 20], [43, 22, 20], [22, 43, 20], [43, 43, 20], [22, 64, 20]], false), \
        ['windowSetTimeout', ['<function>', 400]] \
    ])
endfunction
unittestRunTest('testLifeTimeout')


function testLifeTimeoutCycle():
    # A blinker - a period-2 cycle, so a new random life is created (keeping the initial state)
    life = testLifeCells(10, 10, [[4, 3], [4, 4], [4, 5]])
    newLife = testLifeCells(10, 10, [[4, 4], [4, 5]])
    testLifeMockAll()
    lifeTimeout(life, testLifeArgs({'borderRatio': 0.4}))
    unittestDeepEqual(unittestMockEnd(), [ \
        ['sessionStorageSet', ['life', jsonStringify(newLife)]], \
        ['documentSetReset', ['lifeReset']], \
        testLifeBoardRender(211, 211, 0, 'white', 'forestgreen', [[85, 85, 20], [85, 106, 20]], false), \
        ['windowSetTimeout', ['<function>', 400]] \
    ])
endfunction
unittestRunTest('testLifeTimeoutCycle')


function testLifeTimeoutStill():
    # A block - a still life, so a new random life is created
    life = testLifeCells(10, 10, [[1, 1], [2, 1], [1, 2], [2, 2]])
    newLife = testLifeCells(10, 10, [[4, 4], [4, 5]])
    testLifeMockAll()
    lifeTimeout(life, testLifeArgs({'borderRatio': 0.4, 'play': false}))
    unittestDeepEqual(unittestMockEnd(), [ \
        ['sessionStorageSet', ['life', jsonStringify(newLife)]], \
        ['documentSetReset', ['lifeReset']], \
        testLifeBoardRender(211, 211, 0, 'white', 'forestgreen', [[85, 85, 20], [85, 106, 20]], true) \
    ])
endfunction
unittestRunTest('testLifeTimeoutStill')


function testLifeTimeoutDepthZero():
    # Cycle detection is disabled - the blinker continues
    life = testLifeCells(10, 10, [[4, 3], [4, 4], [4, 5]])
    nextLife = testLifeCells(10, 10, [[3, 4], [4, 4], [5, 4]])
    testLifeMockAll()
    lifeTimeout(life, testLifeArgs({'depth': 0}))
    unittestDeepEqual(unittestMockEnd(), [ \
        ['sessionStorageSet', ['life', jsonStringify(nextLife)]], \
        ['documentSetReset', ['lifeReset']], \
        testLifeBoardRender(211, 211, 0, 'white', 'forestgreen', [[64, 85, 20], [85, 85, 20], [106, 85, 20]], false), \
        ['windowSetTimeout', ['<function>', 400]] \
    ])
endfunction
unittestRunTest('testLifeTimeoutDepthZero')


function testLifeTimeoutLookahead():
    # The second timeout reuses the generations computed by the first
    life = testLifeCells(10, 10, [[1, 0], [2, 1], [0, 2], [1, 2], [2, 2]])
    args = testLifeArgs()
    testLifeMockAll()
    lifeTimeout(life, args)
    lookahead = lifeLookahead
    calls = unittestMockEnd()
    timeoutFn = arrayGet(arrayGet(arrayGet(calls, 3), 1), 0)
    generations = arrayCopy(objectGet(lookahead, 'generations'))
    unittestDeepEqual(testLifePoints(arrayGet(generations, 0)), [[0, 1], [2, 1], [1, 2], [2, 2], [1, 3]])
    unittestEqual(arrayLength(generations), 6)
    unittestEqual(arrayLength(objectGet(lookahead, 'generationsJSON')), 6)

    # Call the timeout function - the next life is the first timeout's second generation
    testLifeMockAll()
    timeoutFn()
    unittestDeepEqual(unittestMockEnd(), [ \
        ['sessionStorageSet', ['life', jsonStringify(testLifeCells(10, 10, [[2, 1], [0, 2], [2, 2], [1, 3], [2, 3]]))]], \
        ['documentSetReset', ['lifeReset']], \
        testLifeBoardRender(211, 211, 0, 'white', 'forestgreen', \
            [[43, 22, 20], [1, 43, 20], [43, 43, 20], [22, 64, 20], [43, 64, 20]], false), \
        ['windowSetTimeout', ['<function>', 400]] \
    ])
    unittestEqual(systemIs(arrayGet(objectGet(lifeLookahead, 'generations'), 0), arrayGet(generations, 1)), true)

    systemGlobalSet('lifeLookahead', {})
endfunction
unittestRunTest('testLifeTimeoutLookahead')


function testLifeTimeoutLookaheadChanged():
    # The life returned by the first timeout is changed - its generations are recomputed
    life = testLifeCells(10, 10, [[1, 0], [2, 1], [0, 2], [1, 2], [2, 2]])
    args = testLifeArgs()
    testLifeMockAll()
    lifeTimeout(life, args)
    generations = arrayCopy(objectGet(lifeLookahead, 'generations'))
    nextLife = arrayGet(generations, 0)
    arraySet(objectGet(nextLife, 'cells'), 99, 1)
    lifeTimeout(nextLife, args)
    unittestMockEnd()
    nextGenerations = objectGet(lifeLookahead, 'generations')
    unittestDeepEqual(testLifePoints(arrayGet(nextGenerations, 0)), [[2, 1], [0, 2], [2, 2], [1, 3], [2, 3]])
    unittestEqual(systemIs(arrayGet(nextGenerations, 0), arrayGet(generations, 1)), false)

    systemGlobalSet('lifeLookahead', {})
endfunction
unittestRunTest('testLifeTimeoutLookaheadChanged')


