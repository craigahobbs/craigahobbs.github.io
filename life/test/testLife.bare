function testLifeNewRandom():
    # Only the cells inside the border are randomized - the mocked random alternates alive and dead
    testLifeMockAll()
    life = lifeNew(testLifeArgs({'borderRatio': 0.3}), 10, 10)
    unittestDeepEqual(unittestMockEnd(), [])
    unittestDeepEqual(testLifePoints(life), [ \
        [3, 3], [5, 3], \
        [3, 4], [5, 4], \
        [3, 5], [5, 5], \
        [3, 6], [5, 6] \
    ])
    unittestEqual(objectGet(life, 'initial'), lifeEncode(life))
endfunction
unittestRunTest('testLifeNewRandom')


