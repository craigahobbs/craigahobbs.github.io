include <args.bare>
include <base64.bare>
include <forms.bare>
include <gzip.bare>
include <unittest.bare>
include <unittestMock.bare>

include '../life.bare'
include 'testLifeHelpers.bare'


# The expected menu renders for the default arguments
testLifeMenuRenderPlay = testLifeMenuRender(testLifeMenuPlay( \
    testLifeMenuColor('#var.vBackground=2', '#var.vColor=2', '#var.vBorder=5'), \
    '2', '#var.vRate=1', '#var.vRate=3' \
))
testLifeMenuRenderPause = testLifeMenuRender(testLifeMenuPause( \
    testLifeMenuColor('#var.vBackground=2', '#var.vColor=2', '#var.vBorder=5') \
))

# The encoding of a 10x10 Life board with cell (1, 1) alive
testLifeEncoded = 'H4sIAAAAAAAA/6tWSk7NySlWsoo20MEGDbGKDmIYq6OUkZqZnlGiZGVooKNUnplSkgFi1gIAEstg3eoAAAA='


#
# lifeMain tests
#


function testLifeMain():
    life = testLifeCells(10, 10, [[1, 1]])
    testLifeMockAll()
    sessionStorageSet('life', jsonStringify(life))
    lifeMain()
    unittestDeepEqual(unittestMockEnd(), [ \
        ['sessionStorageSet', ['life', jsonStringify(life)]], \
        ['documentSetTitle', ["Conway's Game of Life"]], \
        testLifeMenuRenderPlay, \
        testLifeBoardRender(211, 211, 0, 'white', 'forestgreen', [[22, 22, 20]], false), \
        ['windowSetTimeout', ['<function>', 500]], \
        ['windowSetResize', ['<function>']] \
    ])
endfunction
unittestRunTest('testLifeMain')


function testLifeMainResizeBinding():
    life = testLifeCells(10, 10, [[1, 1]])
    lifeJSON = jsonStringify(life)
    testLifeMockAll()
    sessionStorageSet('life', lifeJSON)
    lifeMain()
    calls = unittestMockEnd()
    resizeCall = arrayGet(calls, arrayLength(calls) - 1)
    unittestEqual(arrayGet(resizeCall, 0), 'windowSetResize')
    testSameEffect(arrayGet(arrayGet(resizeCall, 1), 0), systemPartial(lifeRender, jsonParse(lifeJSON), testLifeArgs()))
endfunction
unittestRunTest('testLifeMainResizeBinding')


function testLifeMainLoad():
    systemGlobalSet('vLoad', testLifeEncoded)
    testLifeMockAll()
    sessionStorageSet('life', jsonStringify(testLifeCells(10, 10, [])))
    lifeMain()
    unittestDeepEqual(unittestMockEnd(), [ \
        ['sessionStorageSet', ['life', jsonStringify(testLifeCells(10, 10, []))]], \
        ['documentSetTitle', ["Conway's Game of Life"]], \
        ['sessionStorageSet', ['life', jsonStringify(testLifeCells(10, 10, [[1, 1]], testLifeEncoded))]], \
        testLifeMenuRenderPlay, \
        testLifeBoardRender(211, 211, 0, 'white', 'forestgreen', [[22, 22, 20]], false), \
        ['windowSetTimeout', ['<function>', 500]], \
        ['windowSetResize', ['<function>']] \
    ])
    systemGlobalSet('vLoad', null)
endfunction
unittestRunTest('testLifeMainLoad')


function testLifeMainLoadAlreadyLoaded():
    # The session life was loaded from vLoad and has since changed - it is not reloaded
    life = testLifeCells(10, 10, [[2, 2]], testLifeEncoded)
    systemGlobalSet('vLoad', testLifeEncoded)
    testLifeMockAll()
    sessionStorageSet('life', jsonStringify(life))
    lifeMain()
    unittestDeepEqual(unittestMockEnd(), [ \
        ['sessionStorageSet', ['life', jsonStringify(life)]], \
        ['documentSetTitle', ["Conway's Game of Life"]], \
        testLifeMenuRenderPlay, \
        testLifeBoardRender(211, 211, 0, 'white', 'forestgreen', [[43, 43, 20]], false), \
        ['windowSetTimeout', ['<function>', 500]], \
        ['windowSetResize', ['<function>']] \
    ])
    systemGlobalSet('vLoad', null)
endfunction
unittestRunTest('testLifeMainLoadAlreadyLoaded')


function testLifeMainLoadInvalid():
    # An invalid load argument is ignored
    life = testLifeCells(10, 10, [[2, 2]])
    systemGlobalSet('vLoad', 'invalid')
    testLifeMockAll()
    sessionStorageSet('life', jsonStringify(life))
    lifeMain()
    unittestDeepEqual(unittestMockEnd(), [ \
        ['sessionStorageSet', ['life', jsonStringify(life)]], \
        ['documentSetTitle', ["Conway's Game of Life"]], \
        ['systemLogDebug', ['base64.bare: base64Decode - Invalid encoded data']], \
        testLifeMenuRenderPlay, \
        testLifeBoardRender(211, 211, 0, 'white', 'forestgreen', [[43, 43, 20]], false), \
        ['windowSetTimeout', ['<function>', 500]], \
        ['windowSetResize', ['<function>']] \
    ])
    systemGlobalSet('vLoad', null)
endfunction
unittestRunTest('testLifeMainLoadInvalid')


function testLifeMainArgumentLimits():
    # Out-of-range arguments are limited - borderRatio to 0.4 (a 10x10 interior) and initRatio to 1 (all alive)
    systemGlobalSet('vBackground', 8)
    systemGlobalSet('vBorder', -3)
    systemGlobalSet('vBorderRatio', 0.9)
    systemGlobalSet('vColor', 9)
    systemGlobalSet('vGap', 0)
    systemGlobalSet('vInitRatio', 2)
    systemGlobalSet('vRate', 20)
    testLifeMockAll()
    lifeMain()

    # The expected new life and its cells
    points = []
    cellRects = []
    y = 20
    while y < 30:
        x = 20
        while x < 30:
            arrayPush(points, [x, y])
            arrayPush(cellRects, [1 + x * 4.2, 1 + y * 4.2, 3.2])
            x = x + 1
        endwhile
        y = y + 1
    endwhile
    life = testLifeCellsEncoded(50, 50, points)

    # The menu links keep the URL's (unlimited) arguments
    unittestDeepEqual(unittestMockEnd(), [ \
        ['documentSetTitle', ["Conway's Game of Life"]], \
        ['sessionStorageSet', ['life', jsonStringify(life)]], \
        testLifeMenuRender(testLifeMenuPlay( \
            testLifeMenuColor( \
                '#var.vBackground=3&var.vBorder=-3&var.vBorderRatio=0.9&var.vColor=9&var.vGap=0&var.vInitRatio=2&var.vRate=20', \
                '#var.vBackground=8&var.vBorder=-3&var.vBorderRatio=0.9&var.vColor=3&var.vGap=0&var.vInitRatio=2&var.vRate=20', \
                '#var.vBackground=8&var.vBorder=5&var.vBorderRatio=0.9&var.vColor=9&var.vGap=0&var.vInitRatio=2&var.vRate=20', \
                '#var.vBackground=8&var.vBorder=-3&var.vBorderRatio=0.9&var.vColor=9&var.vFullScreen=true&var.vGap=0' + \
                    '&var.vInitRatio=2&var.vRate=20' \
            ), \
            '30', \
            '#var.vBackground=8&var.vBorder=-3&var.vBorderRatio=0.9&var.vColor=9&var.vGap=0&var.vInitRatio=2&var.vRate=7', \
            null, \
            '#var.vBackground=8&var.vBorder=-3&var.vBorderRatio=0.9&var.vColor=9&var.vGap=0&var.vInitRatio=2&var.vPlay=false' + \
                '&var.vRate=20' \
        )), \
        testLifeBoardRender(50 * 4.2 + 1, 50 * 4.2 + 1, 0, 'white', 'lightgray', cellRects, false), \
        ['windowSetTimeout', ['<function>', 1000 / 30]], \
        ['windowSetResize', ['<function>']] \
    ])

    systemGlobalSet('vBackground', null)
    systemGlobalSet('vBorder', null)
    systemGlobalSet('vBorderRatio', null)
    systemGlobalSet('vColor', null)
    systemGlobalSet('vGap', null)
    systemGlobalSet('vInitRatio', null)
    systemGlobalSet('vRate', null)
endfunction
unittestRunTest('testLifeMainArgumentLimits')


function testLifeMainArgumentLimitsNegativeColors():
    # Negative colors are limited to 0
    life = testLifeCells(10, 10, [[1, 1]])
    systemGlobalSet('vBackground', -1)
    systemGlobalSet('vColor', -3)
    testLifeMockAll()
    sessionStorageSet('life', jsonStringify(life))
    lifeMain()
    unittestDeepEqual(unittestMockEnd(), [ \
        ['sessionStorageSet', ['life', jsonStringify(life)]], \
        ['documentSetTitle', ["Conway's Game of Life"]], \
        testLifeMenuRender(testLifeMenuPlay( \
            testLifeMenuColor( \
                '#var.vColor=-3', \
                '#var.vBackground=-1&var.vColor=1', \
                '#var.vBackground=-1&var.vBorder=5&var.vColor=-3', \
                '#var.vBackground=-1&var.vColor=-3&var.vFullScreen=true' \
            ), \
            '2', \
            '#var.vBackground=-1&var.vColor=-3&var.vRate=1', \
            '#var.vBackground=-1&var.vColor=-3&var.vRate=3', \
            '#var.vBackground=-1&var.vColor=-3&var.vPlay=false' \
        )), \
        testLifeBoardRender(211, 211, 0, 'forestgreen', 'forestgreen', [[22, 22, 20]], false), \
        ['windowSetTimeout', ['<function>', 500]], \
        ['windowSetResize', ['<function>']] \
    ])
    systemGlobalSet('vBackground', null)
    systemGlobalSet('vColor', null)
endfunction
unittestRunTest('testLifeMainArgumentLimitsNegativeColors')


