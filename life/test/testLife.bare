#
# lifeMenuElements tests
#


function testLifeMenuElementsColors():
    # The next cell color skips the background color, and the next background color skips the cell color
    unittestDeepEqual( \
        lifeMenuElements(null, testLifeArgs({'background': 0, 'border': 5, 'color': 6})), \
        testLifeMenuPlay( \
            testLifeMenuColor('#var=', '#var.vColor=1', '#var='), \
            '2', '#var.vRate=1', '#var.vRate=3' \
        ) \
    )
    unittestDeepEqual( \
        lifeMenuElements(null, testLifeArgs({'background': 3, 'color': 2})), \
        testLifeMenuPlay( \
            testLifeMenuColor('#var.vBackground=4', '#var.vColor=4', '#var.vBorder=5'), \
            '2', '#var.vRate=1', '#var.vRate=3' \
        ) \
    )
endfunction
unittestRunTest('testLifeMenuElementsColors')


function testLifeMenuElementsPauseBindings():
    life = testLifeCells(20, 20, [[4, 3], [4, 4], [4, 5]])
    lifeJSON = jsonStringify(life)
    args = testLifeArgs({'play': false, 'borderRatio': 0.4})
    render = systemPartial(lifeRender, life, args)

    testVerifyClickN(render, 'Step', 0, systemPartial(lifeClickStep, jsonParse(lifeJSON), args))
    testVerifyClickN(render, 'Random', 0, systemPartial(lifeClickRandom, jsonParse(lifeJSON), args))
    testVerifyClickN(render, 'Reset', 0, systemPartial(lifeClickReset, args))
    testVerifyClickN(render, '<<', 0, systemPartial(lifeClickWidthHeight, jsonParse(lifeJSON), args, -5, 0))
    testVerifyClickN(render, '>>', 0, systemPartial(lifeClickWidthHeight, jsonParse(lifeJSON), args, 5, 0))
    testVerifyClickN(render, '<<', 1, systemPartial(lifeClickWidthHeight, jsonParse(lifeJSON), args, 0, -5))
    testVerifyClickN(render, '>>', 1, systemPartial(lifeClickWidthHeight, jsonParse(lifeJSON), args, 0, 5))
endfunction
unittestRunTest('testLifeMenuElementsPauseBindings')


