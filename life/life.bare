include <args.bare>
include <base64.bare>
include <draw.bare>
include <forms.bare>
include <gzip.bare>
include <schema.bare>
include <schemaParser.bare>


# Life application main entry point
function lifeMain():
    # Set the title
    documentSetTitle("Conway's Game of Life")

    # Parse arguments
    args = argsParse(lifeArguments)
    objectSet(args, 'background', mathMax(0, objectGet(args, 'background')) % arrayLength(lifeColors))
    objectSet(args, 'border', mathMax(0, objectGet(args, 'border')))
    objectSet(args, 'borderRatio', mathMax(0, mathMin(0.4, objectGet(args, 'borderRatio'))))
    objectSet(args, 'color', mathMax(0, objectGet(args, 'color')) % arrayLength(lifeColors))
    objectSet(args, 'gap', mathMax(1, objectGet(args, 'gap')))
    objectSet(args, 'initRatio', mathMax(0, mathMin(1, objectGet(args, 'initRatio'))))
    objectSet(args, 'rate', mathMax(0, mathMin(arrayLength(lifeRates) - 1, objectGet(args, 'rate'))))

    # Load the life state
    life = lifeLoad(args)

    # Load argument provided (and not already loaded)?
    load = objectGet(args, 'load')
    if load != null && load != objectGet(life, 'initial'):
        # Decode the load argument - save the loaded life, if valid
        loadedLife = lifeDecode(load)
        if loadedLife != null:
            life = loadedLife
            lifeSave(life)
        endif
    endif

    # Render the application
    lifeRender(life, args)

    # Set the window resize handler
    windowSetResize(systemPartial(lifeRender, life, args))
endfunction


# The Life application arguments
lifeArguments = argsValidate([ \
    {'name': 'background', 'type': 'int', 'default': 1}, \
    {'name': 'border', 'type': 'int', 'default': 0}, \
    {'name': 'borderRatio', 'type': 'float', 'default': 0.1}, \
    {'name': 'color', 'type': 'int', 'default': 0}, \
    {'name': 'depth', 'type': 'int', 'default': 6}, \
    {'name': 'fullScreen', 'type': 'bool', 'default': false}, \
    {'name': 'gap', 'type': 'int', 'default': 1}, \
    {'name': 'initRatio', 'type': 'float', 'default': 0.2}, \
    {'name': 'load', 'explicit': true}, \
    {'name': 'play', 'type': 'bool', 'default': true}, \
    {'name': 'rate', 'type': 'int', 'default': 2}, \
    {'name': 'save', 'type': 'bool', 'default': false, 'explicit': true} \
])


# Render the Life application
function lifeRender(life, args):
    # Render the menu
    elementModelRender([ \
        if(!objectGet(args, 'fullScreen'), \
            {'html': 'p', 'elem': [ \
                {'html': 'b', 'elem': {'text': "Conway's Game of Life"}}, \
                {'html': 'br'}, \
                lifeMenuElements(life, args) \
            ]} \
        ), \
        {'html': 'div', 'attr': {'id': lifeDocumentResetID, 'style': 'display: none;'}} \
    ])

    # Render the Life board
    lifeDraw(life, args)

    # Set the timeout handler
    lifeSetTimeout(life, args)
endfunction


# Helper to set the timeout handler - elapsedMs is the time already spent this period
function lifeSetTimeout(life, args, elapsedMs):
    periodMs = mathMax(0, 1000 / arrayGet(lifeRates, objectGet(args, 'rate')) - if(elapsedMs != null, elapsedMs, 0))
    if objectGet(args, 'play'):
        windowSetTimeout(systemPartial(lifeTimeout, life, args), periodMs)
    endif
endfunction


# Life application timeout handler
function lifeTimeout(life, args):
    startTime = datetimeNow()
    lifeJSON = jsonStringify(objectGet(life, 'cells'))

    # Compute the next generations, through the cycle-detection depth. If this is the (unchanged) life the
    # previous timeout returned (its first generation), reuse the generations it computed - only the last
    # generation is new.
    depth = objectGet(args, 'depth')
    generations = objectGet(lifeLookahead, 'generations')
    generationsJSON = objectGet(lifeLookahead, 'generationsJSON')
    if generations != null && systemIs(life, arrayGet(generations, 0)) && lifeJSON == arrayGet(generationsJSON, 0):
        arrayShift(generations)
        arrayShift(generationsJSON)
    else:
        generations = []
        generationsJSON = []
    endif
    while arrayLength(generations) < mathMax(1, depth):
        generation = lifeNext(if(arrayLength(generations), arrayGet(generations, arrayLength(generations) - 1), life))
        arrayPush(generations, generation)
        arrayPush(generationsJSON, jsonStringify(objectGet(generation, 'cells')))
    endwhile

    # Is there a cycle (does the current generation recur)?
    if arrayIndexOf(arraySlice(generationsJSON, 0, depth), lifeJSON) != -1:
        life = lifeNew(args, objectGet(life, 'width'), objectGet(life, 'height'), objectGet(life, 'initial'))
        systemGlobalSet('lifeLookahead', {})
    else:
        life = arrayGet(generations, 0)
        systemGlobalSet('lifeLookahead', {'generations': generations, 'generationsJSON': generationsJSON})
    endif

    # Update the life state
    lifeSave(life)

    # Render the application
    documentSetReset(lifeDocumentResetID)
    lifeDraw(life, args)

    # Set the timeout handler
    lifeSetTimeout(life, args, datetimeNow() - startTime)
endfunction


# Create the Life application menu element model
function lifeMenuElements(life, args):
    # Menu separators
    nbsp = stringFromCharCode(160)
    linkSeparator = {'text': ' '}
    linkSection = {'text': nbsp + '| '}

    # Color menu part
    background = objectGet(args, 'background')
    border = objectGet(args, 'border')
    color = objectGet(args, 'color')
    nextColor = (color + 1) % arrayLength(lifeColors)
    nextColor = if(nextColor != background, nextColor, (nextColor + 1) % arrayLength(lifeColors))
    nextBackground = (background + 1) % arrayLength(lifeColors)
    nextBackground = if(nextBackground != color, nextBackground, (nextBackground + 1) % arrayLength(lifeColors))
    colorElements = [ \
        formsLinkElements('Ground', argsURL(lifeArguments, {'background': nextBackground})), \
        linkSeparator, \
        formsLinkElements('Cell', argsURL(lifeArguments, {'color': nextColor})), \
        linkSeparator, \
        formsLinkElements('Border', argsURL(lifeArguments, {'border': if(border == 0, 5, 0)})), \
        linkSection, \
        formsLinkElements('Full', argsURL(lifeArguments, {'fullScreen': 1})) \
    ]

    # Which menu? (play, save, or pause)
    if objectGet(args, 'play'):
        rate = objectGet(args, 'rate')
        return [ \
            formsLinkElements('Pause', argsURL(lifeArguments, {'play': 0})), \
            linkSection, \
            colorElements, \
            linkSection, \
            formsLinkElements('<<', if(rate > 0, argsURL(lifeArguments, {'rate': rate - 1}))), \
            [{'text': nbsp + arrayGet(lifeRates, rate) + nbsp + 'Hz' + nbsp}], \
            formsLinkElements('>>', if(rate < arrayLength(lifeRates) - 1, argsURL(lifeArguments, {'rate': rate + 1}))) \
        ]
    elif objectGet(args, 'save'):
        return [ \
            {'text': 'Save: '}, \
            formsLinkElements('Load', argsURL(lifeArguments, {'load': lifeEncode(life)})) \
        ]
    endif

    # Pause menu
    return [ \
        formsLinkElements('Play', argsURL(lifeArguments, {'play': 1})), \
        linkSection, \
        formsLinkButtonElements('Step', systemPartial(lifeClickStep, life, args)), \
        linkSeparator, \
        formsLinkButtonElements('Random', systemPartial(lifeClickRandom, life, args)), \
        linkSeparator, \
        formsLinkButtonElements('Reset', systemPartial(lifeClickReset, args)), \
        linkSeparator, \
        formsLinkElements('Save', argsURL(lifeArguments, {'play': 0, 'save': 1})), \
        linkSection, \
        colorElements, \
        linkSection, \
        formsLinkButtonElements('<<', systemPartial(lifeClickWidthHeight, life, args, -5, 0)), \
        [{'text': nbsp + 'Width' + nbsp}], \
        formsLinkButtonElements('>>', systemPartial(lifeClickWidthHeight, life, args, 5, 0)), \
        linkSection, \
        formsLinkButtonElements('<<', systemPartial(lifeClickWidthHeight, life, args, 0, -5)), \
        [{'text': nbsp + 'Height' + nbsp}], \
        formsLinkButtonElements('>>', systemPartial(lifeClickWidthHeight, life, args, 0, 5)) \
    ]
endfunction


# The Life application menu change rates, in Hz
lifeRates = [0.5, 1, 2, 4, 6, 8, 10, 20, 30]

# The Life application menu colors
lifeColors = ['forestgreen', 'white' , 'lightgray', 'greenyellow', 'gold', 'magenta', 'cornflowerblue']

# The Life application menu/board document reset ID
lifeDocumentResetID = 'lifeReset'

# The cycle-detection generations computed by the previous timeout handler call (empty if none)
lifeLookahead = {}


# Life application step click handler
function lifeClickStep(life, args):
    life = lifeNext(life)
    lifeSave(life)
    lifeRender(life, args)
endfunction


# Life application random click handler
function lifeClickRandom(life, args):
    life = lifeNew(args, objectGet(life, 'width'), objectGet(life, 'height'))
    lifeSave(life)
    lifeRender(life, args)
endfunction


# Life application reset click handler
function lifeClickReset(args):
    # Create a default life
    life = lifeNew(args)
    lifeSave(life)

    # If we're already at the reset location, just update
    resetLocation = argsURL(lifeArguments, {'play': false}, true)
    if resetLocation == argsURL(lifeArguments):
        lifeRender(life, args)
        return
    endif

    windowSetLocation(resetLocation)
endfunction


# Life application width/height click handler
function lifeClickWidthHeight(life, args, widthDelta, heightDelta):
    width = mathMax(10, widthDelta + objectGet(life, 'width'))
    height = mathMax(10, heightDelta + objectGet(life, 'height'))
    life = lifeNew(args, width, height)
    lifeSave(life)
    lifeRender(life, args)
endfunction


# Life application cell click handler
function lifeClickCell(life, args, px, py):
    width = objectGet(life, 'width')
    height = objectGet(life, 'height')
    size = lifeSize(life, args)
    gap = objectGet(args, 'gap')
    border = objectGet(args, 'border')

    # Compute the cell index to toggle
    x = mathMax(0, mathMin(width - 1, mathFloor((px - border) / (size + gap))))
    y = mathMax(0, mathMin(height - 1, mathFloor((py - border) / (size + gap))))
    iCell = y * width + x

    # Toggle the cell
    cells = objectGet(life, 'cells')
    arraySet(cells, iCell, if(arrayGet(cells, iCell), 0, 1))

    # Update the life state and re-render
    lifeSave(life)
    lifeRender(life, args)
endfunction


# Create a new Life object
function lifeNew(args, width, height, initial):
    width = if(width != null, width, 50)
    height = if(height != null, height, 50)
    cells = arrayNewSize(width * height)

    # Initialize the life
    if args != null:
        initRatio = objectGet(args, 'initRatio')
        borderRatio = objectGet(args, 'borderRatio')
        border = mathCeil(borderRatio * mathMin(width, height))
        y = 0
        while y < height:
            x = 0
            while x < width:
                arraySet(cells, y * width + x, \
                    if(x >= border && x < width - border && y >= border && y < height - border && mathRandom() < initRatio, 1, 0))
                x = x + 1
            endwhile
            y = y + 1
        endwhile
    endif

    # Create the blank life object
    life = {'width': width, 'height': height, 'initial': initial, 'cells': cells}
    if initial == null:
        objectSet(life, 'initial', lifeEncode(life))
    endif

    return life
endfunction


# Load and validate the Life object from session storage, or create a new one
function lifeLoad(args):
    # Parse and validate the session storage
    lifeJSON = sessionStorageGet('life')
    life = if(lifeJSON != null, jsonParse(lifeJSON))
    life = if(life != null, lifeValidate(life))

    # If there is no session, create a default session
    if life == null:
        life = lifeNew(args)
        lifeSave(life)
    endif

    return life
endfunction


# Validate a Life object - returns null if invalid
function lifeValidate(life):
    life = schemaValidate(lifeSession, 'Life', life)
    if life == null || objectGet(life, 'width') * objectGet(life, 'height') != arrayLength(objectGet(life, 'cells')):
        return null
    endif
    return life
endfunction


# Save the Life object to session storage
function lifeSave(life):
    sessionStorageSet('life', jsonStringify(life))
endfunction


# Draw the life board
function lifeDraw(life, args):
    # Set the drawing size
    width = objectGet(life, 'width')
    height = objectGet(life, 'height')
    size = lifeSize(life, args)
    gap = objectGet(args, 'gap')
    border = objectGet(args, 'border')
    drawNew(width * (gap + size) + gap + 2 * border, height * (gap + size) + gap + 2 * border)

    # Set the cell click handler
    if !objectGet(args, 'play'):
        drawOnClick(systemPartial(lifeClickCell, life, args))
    endif

    # Draw the background
    drawStyle('#606060', border, arrayGet(lifeColors, objectGet(args, 'background')))
    drawRect(0.5 * border, 0.5 * border, drawWidth() - border, drawHeight() - border)

    # Draw the alive cells (the native arrayIndexOf skips the dead cells)
    drawStyle('none', 0, arrayGet(lifeColors, objectGet(args, 'color')))
    cells = objectGet(life, 'cells')
    iCell = arrayIndexOf(cells, 1)
    while iCell != -1:
        x = iCell % width
        y = mathFloor(iCell / width)
        drawPathRect(border + gap + x * (size + gap), border + gap + y * (size + gap), size, size)
        iCell = arrayIndexOf(cells, 1, iCell + 1)
    endwhile
    drawRender()
endfunction


# Compute the Life board cell size
function lifeSize(life, args):
    totalWidth = windowWidth() - 3 * documentFontSize()
    totalHeight = windowHeight() - if(objectGet(args, 'fullScreen'), 3, 6) * documentFontSize()
    width = objectGet(life, 'width')
    height = objectGet(life, 'height')
    gap = objectGet(args, 'gap')
    border = objectGet(args, 'border')
    sizeWidth = (totalWidth - gap * (width + 1) - 2 * border) / width
    sizeHeight = (totalHeight - gap * (height + 1) - 2 * border) / height
    return mathMax(1, mathMin(sizeWidth, sizeHeight))
endfunction


# Compute the next Life object state
function lifeNext(life):
    width = objectGet(life, 'width')
    height = objectGet(life, 'height')
    cells = objectGet(life, 'cells')

    # Compute the next life generation
    nextLife = lifeNew(null, width, height, objectGet(life, 'initial'))
    nextCells = objectGet(nextLife, 'cells')

    # The above, current, and below rows, each padded with a trailing dead cell - the rows beyond the top and
    # bottom edges are dead
    rowDead = arrayNewSize(width + 1, 0)
    rowAbove = rowDead
    rowCurrent = arraySlice(cells, 0, width)
    arrayPush(rowCurrent, 0)
    y = 0
    while y < height:
        iRow = y * width
        if y < height - 1:
            rowBelow = arraySlice(cells, iRow + width, iRow + 2 * width)
            arrayPush(rowBelow, 0)
        else:
            rowBelow = rowDead
        endif

        # Slide a window of three column sums along the row - the window total includes the cell itself. A cell is
        # alive next generation if the total is 3 (a birth, or survival with two neighbors), or if the total is 4
        # and the cell is alive (survival with three neighbors).
        sumLeft = 0
        sumCenter = arrayGet(rowAbove, 0) + arrayGet(rowCurrent, 0) + arrayGet(rowBelow, 0)
        x = 0
        while x < width:
            xRight = x + 1
            sumRight = arrayGet(rowAbove, xRight) + arrayGet(rowCurrent, xRight) + arrayGet(rowBelow, xRight)
            total = sumLeft + sumCenter + sumRight
            arraySet(nextCells, iRow + x, if(total == 3 || (total == 4 && arrayGet(rowCurrent, x)), 1, 0))
            sumLeft = sumCenter
            sumCenter = sumRight
            x = xRight
        endwhile

        rowAbove = rowCurrent
        rowCurrent = rowBelow
        y = y + 1
    endwhile

    return nextLife
endfunction


# Encode the Life object - the base64-encoded, gzip-compressed JSON of its size and cells
function lifeEncode(life):
    lifeJSON = jsonStringify({ \
        'width': objectGet(life, 'width'), \
        'height': objectGet(life, 'height'), \
        'cells': objectGet(life, 'cells') \
    })
    return base64Encode(gzipCompress(stringEncode(lifeJSON)))
endfunction


# Decode an encoded Life object - returns null if invalid
function lifeDecode(lifeStr):
    # Decode, uncompress, and parse the Life object's JSON
    lifeBytes = base64Decode(lifeStr)
    lifeBytes = if(lifeBytes != null, gzipUncompress(lifeBytes))
    lifeJSON = if(lifeBytes != null, stringDecode(lifeBytes))
    life = if(lifeJSON != null, jsonParse(lifeJSON))
    if systemType(life) != 'object':
        return null
    endif

    # Validate the Life object
    objectSet(life, 'initial', lifeStr)
    return lifeValidate(life)
endfunction


# Life session state object schema
lifeSession = schemaParse( \
    '# The Life session state', \
    'struct Life', \
    '', \
    '    # The Life board width', \
    '    int(>= 10) width', \
    '', \
    '    # The Life board height', \
    '    int(>= 10) height', \
    '', \
    '    # The Life board cell state array', \
    '    int(>= 0, <= 1)[len > 0] cells', \
    '', \
    "    # The Life board's encoded initial cell state", \
    '    string initial' \
)
