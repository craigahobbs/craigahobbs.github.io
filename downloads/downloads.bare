include <args.bare>
include <data.bare>
include <dataLineChart.bare>
include <dataTable.bare>
include <markdown.bare>
include <url.bare>


async function downloadsMain(options):
    args = argsParse(downloadsArguments)
    objectSet(args, 'days', mathMax(1, objectGet(args, 'days')))
    objectSet(args, 'years', mathMax(0, objectGet(args, 'years')))
    page = objectGet(args, 'page')
    name = objectGet(args, 'name')
    language = objectGet(args, 'language')

    # Chart page?
    if page == 'chart':
        return downloadsChartPage(args, options)
    endif

    # Package dashboard?
    if name != null && language != null:
        return downloadsDashboard(args)
    endif

    # Render the index page
    downloadsIndex(args)
endfunction


downloadsArguments = argsValidate([ \
    {'name': 'page'}, \
    {'name': 'name'}, \
    {'name': 'language'}, \
    {'name': 'days', 'type': 'int', 'default': 90}, \
    {'name': 'years', 'type': 'int', 'default': 1} \
])


async function downloadsIndex(args):
    trailingDays = objectGet(args, 'days')

    # Document title
    title = 'Package Downloads'
    markdownPrint( \
        '# ' + markdownEscape(title), \
        '', \
        downloadsYearsControls(args), \
        '', \
        argsLink(downloadsArguments, 'Time Chart', {'page': 'chart'}) \
    )
    documentSetTitle(title)

    # Load the package data
    data = downloadsDataLoad()
    if data == null:
        return
    endif
    dataAverage = downloadsDataAverage(data, trailingDays, true)

    # Create links and compute total downloads
    totalDownloads = 0
    for row in dataAverage:
        rowPackage = objectGet(row, 'Package')
        rowLanguage = objectGet(row, 'Language')
        totalDownloads = totalDownloads + objectGet(row, 'Downloads')

        # Package page link
        objectSet(row, 'Package', argsLink(downloadsArguments, rowPackage, {'name': rowPackage, 'language': rowLanguage}))

        # Package repository link
        if rowLanguage == 'Python':
            packageURL = 'https://pypi.org/project/' + urlEncodeComponent(rowPackage) + '/'
        else:
            packageURL = 'https://www.npmjs.com/package/' + urlEncodeComponent(rowPackage)
        endif
        objectSet(row, 'Language', '[' + markdownEscape(rowLanguage) + '](' + packageURL + ')')
    endfor
    dataSort(dataAverage, [['Downloads', true]])
    arrayPush(dataAverage, {'Package': '**Total**', 'Language': '', 'Downloads': totalDownloads})

    # Render the package downloads table
    dataTable(dataAverage, { \
        'fields': ['Package', 'Language', 'Downloads'], \
        'formats': { \
            'Package': {'markdown': true}, \
            'Language': {'markdown': true}, \
            'Downloads': {'align': 'right', 'header': 'Monthly Downloads'} \
        }, \
        'precision': 0 \
    })
endfunction


function downloadsYearsControls(args):
    years = objectGet(args, 'years')
    return [ \
        '**Showing:** ' + if(years <= 0, 'Current', if(years == 1, '1 year', years + ' years')), \
        '(' + argsLink(downloadsArguments, 'Fewer', {'years': mathMax(0, years - 1)}) + ' | ', \
        argsLink(downloadsArguments, 'More', {'years': years + 1}) + ')' \
    ]
endfunction


async function downloadsChartPage(args, options):
    # Render the title
    title = 'Downloads Chart'
    documentSetTitle(title)
    markdownPrint( \
        argsLink(downloadsArguments, 'Back', {'page': null}), \
        '', \
        '# ' + markdownEscape(title), \
        '', \
        downloadsYearsControls(args) \
    )

    # Load the package data
    data = downloadsDataLoad()
    if data == null:
        return
    endif
    data = downloadsDataYears(data, objectGet(args, 'years'))

    # Add the featured column
    dataCalculatedField( \
        data, \
        'Featured', \
        'if(objectHas(featuredMap, Package), objectGet(objectGet(featuredMap, Package), Language, false), false)', \
        {'featuredMap': objectGet(options, 'featured', {})} \
    )

    # First featured, then non-featured
    for isFeatured in [true, false]:
        # Create the chart
        dataMonthly = downloadsDataMonthly(dataFilter(data, '!!Featured == isFeatured', {'isFeatured': isFeatured}))
        if !dataMonthly:
            continue
        endif
        fontSize = documentFontSize()
        chartWidth = mathFloor(mathMin(1000, mathMax(600, windowWidth() - 4 * fontSize)))
        chartHeight = mathFloor(0.3 * chartWidth)
        dataLineChart(dataMonthly, { \
            'title': 'Monthly Downloads' + if(isFeatured, ' (Featured)', ''), \
            'width': chartWidth, \
            'height': chartHeight, \
            'x': 'Month', \
            'y': ['Downloads'], \
            'color': 'Unique' \
        }, {'fontSize': fontSize})
    endfor

    # Redraw on resize
    windowSetResize(systemPartial(downloadsChartPage, args, options))
endfunction


async function downloadsDashboard(args):
    name = objectGet(args, 'name')
    language = objectGet(args, 'language')
    trailingDays = objectGet(args, 'days')

    # Document title
    title = name + ' (' + language + ') Downloads'
    markdownPrint( \
        argsLink(downloadsArguments, 'Back', {'name': null, 'language': null}), \
        '', \
        '# ' + markdownEscape(title), \
        '', \
        downloadsYearsControls(args) \
    )
    documentSetTitle(title)

    # Load the package data
    data = downloadsDataLoad()
    if data == null:
        return
    endif

    # Filter to this package's data within the years
    filterExpr = 'Package == packageName && Language == packageLanguage'
    filterVars = {'packageName': name, 'packageLanguage': language}
    dataYears = dataFilter(downloadsDataYears(data, objectGet(args, 'years')), filterExpr, filterVars)
    if !dataYears:
        markdownPrint('', '**Error:** No data for package')
        return
    endif

    # Compute the monthly average - use all data so the average matches the index page
    monthlyAverageData = dataFilter(downloadsDataAverage(data, trailingDays, true), filterExpr, filterVars)
    monthlyAverage = objectGet(arrayGet(monthlyAverageData, 0), 'Downloads')

    # Compute the first date with a full trailing window - use all of the package's data so the
    # trailing average is available from the start of the years' data
    data = dataFilter(data, filterExpr, filterVars)
    minDateData = dataAggregate(data, { \
        'measures': [ \
            {'field': 'Date', 'function': 'min'} \
        ] \
    })
    minDateMin = objectGet(arrayGet(minDateData, 0), 'Date')
    minDate = datetimeNew(datetimeYear(minDateMin), datetimeMonth(minDateMin), datetimeDay(minDateMin) + trailingDays - 1)

    # Compute the daily trailing average
    trailingAverageSum = 0
    dataTrailingAverage = []
    for row in data:
        # Compute the trailing average
        trailingAverageSum = trailingAverageSum + objectGet(row, 'Downloads', 0)
        arrayPush(dataTrailingAverage, row)
        rowDate = objectGet(row, 'Date')
        dateTrailingAverage = datetimeNew(datetimeYear(rowDate), datetimeMonth(rowDate), datetimeDay(rowDate) - trailingDays)
        while objectGet(arrayGet(dataTrailingAverage, 0), 'Date') <= dateTrailingAverage:
            trailingAverageSum = trailingAverageSum - objectGet(arrayGet(dataTrailingAverage, 0), 'Downloads', 0)
            arrayDelete(dataTrailingAverage, 0)
        endwhile

        # Add the average downloads field
        if rowDate >= minDate:
            objectSet(row, 'Average Downloads', trailingAverageSum / trailingDays)
        endif
    endfor

    # Render the years' data - its rows are the same objects, so they have the trailing average
    data = dataYears
    dataMonthly = downloadsDataMonthly(data)

    # Render the monthly line chart
    fontSize = documentFontSize()
    chartWidth = mathFloor(mathMin(1000, mathMax(600, windowWidth() - 4 * fontSize)))
    chartHeight = mathFloor(0.25 * chartWidth)
    if dataMonthly:
        dataLineChart(dataMonthly, { \
            'title': 'Monthly Downloads - ' + name, \
            'width': chartWidth - 12 * fontSize, \
            'height': chartHeight, \
            'x': 'Month', \
            'y': ['Downloads'], \
            'xLines': [ \
                {'value': downloadsDataAverageMinDate(dataMonthly, trailingDays, 'Month'), 'label': ''} \
            ], \
            'yLines': [ \
                {'value': monthlyAverage} \
            ] \
        }, {'fontSize': fontSize})
    endif

    # Render the daily line chart
    dataLineChart(data, { \
        'title': 'Daily Downloads - ' + name, \
        'width': chartWidth, \
        'height': chartHeight, \
        'x': 'Date', \
        'y': ['Average Downloads', 'Downloads'], \
        'xLines': [ \
            {'value': downloadsDataAverageMinDate(data, trailingDays), 'label': ''} \
        ], \
        'yLines': [ \
            {'value': monthlyAverage / 30} \
        ] \
    }, {'fontSize': fontSize})

    # Render the monthly table by most recent
    if dataMonthly:
        dataSort(dataMonthly, [['Month', true]])
        dataCalculatedField( \
            dataMonthly, \
            '% Average', 'if(monthlyAverage, numberToFixed((100 * (Downloads - monthlyAverage) / monthlyAverage), 1, true) + "%", "")', \
            {'monthlyAverage': monthlyAverage} \
        )
        dataTable(dataMonthly, { \
            'fields': ['Month', 'Downloads', '% Average'], \
            'formats': { \
                'Downloads': {'align': 'right'} \
            }, \
            'datetime': 'month', \
            'precision': 0 \
        })
    endif

    # Redraw on resize
    windowSetResize(systemPartial(downloadsDashboard, args))
endfunction


async function downloadsDataLoad():
    # Fetch and validate the data
    dataText = systemFetch('downloads.json')
    data = if(dataText != null, jsonParse(dataText))
    if data == null:
        markdownPrint('', '**Error:** Failed to load downloads data')
        return null
    endif
    dataValidate(data, true)

    # Compute the unique package names
    nameLanguages = {}
    for row in data:
        name = objectGet(row, 'Package')
        language = objectGet(row, 'Language')
        languages = objectGet(nameLanguages, name)
        if !languages:
            objectSet(nameLanguages, name, {language: true})
        else:
            objectSet(languages, language, true)
        endif
    endfor
    for row in data:
        name = objectGet(row, 'Package')
        language = objectGet(row, 'Language')
        if arrayLength(objectKeys(objectGet(nameLanguages, name))) == 1:
            objectSet(row, 'Unique', name)
        elif language == 'Python':
            objectSet(row, 'Unique', name + ' (py)')
        else:
            objectSet(row, 'Unique', name + ' (js)')
        endif
    endfor

    return data
endfunction


function downloadsDataYears(data, years):
    # Filter to the data on or after January 1st, "years" years before the most recent data
    maxDateData = dataAggregate(data, { \
        'measures': [ \
            {'field': 'Date', 'function': 'max'} \
        ] \
    })
    maxDate = objectGet(arrayGet(maxDateData, 0), 'Date')
    minDate = datetimeNew(datetimeYear(maxDate) - years, 1, 1)
    return dataFilter(data, 'Date >= minDate', {'minDate': minDate})
endfunction


function downloadsDataMonthly(data):
    # Filter-out the current month
    today = datetimeToday()
    maxDate = datetimeNew(datetimeYear(today), datetimeMonth(today), 1)
    dataFiltered = dataFilter(data, 'Date < maxDate', {'maxDate': maxDate})

    # Compute the month field
    dataCalculatedField(dataFiltered, 'Month', 'datetimeISOParse(stringSlice(datetimeISOFormat(Date, true), 0, 7) + "-01")')

    # Aggregate by month
    return dataAggregate(dataFiltered, { \
        'categories': ['Language', 'Package', 'Unique', 'Month'], \
        'measures': [ \
            { \
                'field': 'Downloads', \
                'function': 'sum' \
            } \
        ] \
    })
endfunction


function downloadsDataAverage(data, trailingDays, monthly):
    # Zero the downloads outside the trailing window - every package gets an average, even if zero
    minDate = downloadsDataAverageMinDate(data, trailingDays)
    dataWindow = []
    for row in data:
        arrayPush(dataWindow, { \
            'Language': objectGet(row, 'Language'), \
            'Package': objectGet(row, 'Package'), \
            'Unique': objectGet(row, 'Unique'), \
            'Downloads': if(objectGet(row, 'Date') > minDate, objectGet(row, 'Downloads'), 0) \
        })
    endfor

    # Compute the average
    dataAverage = dataAggregate(dataWindow, { \
        'categories': ['Language', 'Package', 'Unique'], \
        'measures': [ \
            {'field': 'Downloads', 'function': 'sum'} \
        ] \
    })
    dataCalculatedField( \
        dataAverage, \
        'Downloads', \
        'if(monthly, Downloads * 30, Downloads) / trailingDays', \
        {'trailingDays': trailingDays, 'monthly': monthly} \
    )

    return dataAverage
endfunction


function downloadsDataAverageMinDate(data, trailingDays, field):
    field = if(field, field, 'Date')
    maxDateData = dataAggregate(data, { \
        'measures': [ \
            {'field': field, 'function': 'max'} \
        ] \
    })
    maxDate = objectGet(arrayGet(maxDateData, 0), field)
    return datetimeNew(datetimeYear(maxDate), datetimeMonth(maxDate), datetimeDay(maxDate) - trailingDays)
endfunction
