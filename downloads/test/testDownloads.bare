async function testDownloadsDataLoad():
    unittestMockAll(testDownloadsMockData())
    data = downloadsDataLoad()
    unittestDeepEqual(unittestMockEnd(), [ \
        ['systemFetch', ['downloads.json']] \
    ])
    unittestDeepEqual(data, testDownloadsData())
endfunction
unittestRunTest('testDownloadsDataLoad')


async function testDownloadsDataLoadFetchError():
    unittestMockAll({})
    data = downloadsDataLoad()
    unittestDeepEqual(unittestMockEnd(), [ \
        ['systemFetch', ['downloads.json']], \
        ['markdownPrint', ['', '**Error:** Failed to load downloads data']] \
    ])
    unittestEqual(data, null)
endfunction
unittestRunTest('testDownloadsDataLoadFetchError')


#
# downloadsDataAverage
#


function testDownloadsDataAverage():
    # The 3-day trailing window is 2024-02-01 through 2024-02-03
    unittestDeepEqual(downloadsDataAverage(testDownloadsData(), 3, true), [ \
        testDownloadsAggregateRow('alpha', 'Python', 'alpha (py)', 12 * 30 / 3), \
        testDownloadsAggregateRow('beta', 'Python', 'beta', 7 * 30 / 3), \
        testDownloadsAggregateRow('alpha', 'JavaScript', 'alpha (js)', 30 * 30 / 3) \
    ])
    unittestDeepEqual(downloadsDataAverage(testDownloadsData(), 3, false), [ \
        testDownloadsAggregateRow('alpha', 'Python', 'alpha (py)', 12 / 3), \
        testDownloadsAggregateRow('beta', 'Python', 'beta', 7 / 3), \
        testDownloadsAggregateRow('alpha', 'JavaScript', 'alpha (js)', 30 / 3) \
    ])
endfunction
unittestRunTest('testDownloadsDataAverage')


function testDownloadsDataAverageZero():
    # A package with no downloads in the trailing window has a zero average
    unittestDeepEqual(downloadsDataAverage(testDownloadsData(), 1, true), [ \
        testDownloadsAggregateRow('alpha', 'Python', 'alpha (py)', 5 * 30), \
        testDownloadsAggregateRow('beta', 'Python', 'beta', 0), \
        testDownloadsAggregateRow('alpha', 'JavaScript', 'alpha (js)', 20 * 30) \
    ])
endfunction
unittestRunTest('testDownloadsDataAverageZero')


function testDownloadsDataAverageNull():
    # Null and missing downloads are skipped
    data = testDownloadsData()
    arrayPush(data, {'Package': 'beta', 'Language': 'Python', 'Unique': 'beta', 'Date': datetimeNew(2024, 2, 2), 'Downloads': null})
    arrayPush(data, {'Package': 'beta', 'Language': 'Python', 'Unique': 'beta', 'Date': datetimeNew(2024, 2, 3)})
    unittestDeepEqual(downloadsDataAverage(data, 3, false), [ \
        testDownloadsAggregateRow('alpha', 'Python', 'alpha (py)', 12 / 3), \
        testDownloadsAggregateRow('beta', 'Python', 'beta', 7 / 3), \
        testDownloadsAggregateRow('alpha', 'JavaScript', 'alpha (js)', 30 / 3) \
    ])
endfunction
unittestRunTest('testDownloadsDataAverageNull')


function testDownloadsDataAverageMinDate():
    unittestEqual(downloadsDataAverageMinDate(testDownloadsData(), 3), datetimeNew(2024, 1, 31))
    unittestEqual( \
        downloadsDataAverageMinDate([{'Month': datetimeNew(2024, 1, 1)}, {'Month': datetimeNew(2024, 2, 1)}], 3, 'Month'), \
        datetimeNew(2024, 1, 29) \
    )
endfunction
unittestRunTest('testDownloadsDataAverageMinDate')


function testDownloadsDataMaxDate():
    # The rows need not be in date order
    data = [ \
        {'Date': datetimeNew(2024, 2, 1), 'Month': datetimeNew(2024, 1, 1)}, \
        {'Date': datetimeNew(2024, 3, 1), 'Month': datetimeNew(2024, 2, 1)}, \
        {'Date': datetimeNew(2024, 1, 1), 'Month': datetimeNew(2023, 12, 1)} \
    ]
    unittestEqual(downloadsDataMaxDate(data, 'Date'), datetimeNew(2024, 3, 1))
    unittestEqual(downloadsDataMaxDate(data, 'Month'), datetimeNew(2024, 2, 1))
endfunction
unittestRunTest('testDownloadsDataMaxDate')


#
# downloadsDataTrailingAverage
#


function testDownloadsDataTrailingAverage():
    # Each package's 2-day trailing average starts at its first full window - the packages' rows
    # are interleaved by date, but their sums are not mixed
    data = testDownloadsData()
    downloadsDataTrailingAverage(data, 2)
    expected = testDownloadsData()
    objectSet(arrayGet(expected, 1), 'Average Downloads', (100 + 1) / 2)
    objectSet(arrayGet(expected, 2), 'Average Downloads', 2 / 2)
    objectSet(arrayGet(expected, 3), 'Average Downloads', (2 + 3) / 2)
    objectSet(arrayGet(expected, 6), 'Average Downloads', (3 + 4) / 2)
    objectSet(arrayGet(expected, 7), 'Average Downloads', (10 + 20) / 2)
    objectSet(arrayGet(expected, 8), 'Average Downloads', (4 + 5) / 2)
    unittestDeepEqual(data, expected)
endfunction
unittestRunTest('testDownloadsDataTrailingAverage')


function testDownloadsDataTrailingAverageUnsorted():
    # The rows may be in any order - reversed rows get the same trailing averages, and keep their order
    data = arrayReverse(testDownloadsData())
    downloadsDataTrailingAverage(data, 2)
    expected = testDownloadsData()
    downloadsDataTrailingAverage(expected, 2)
    unittestDeepEqual(data, arrayReverse(expected))
endfunction
unittestRunTest('testDownloadsDataTrailingAverageUnsorted')


