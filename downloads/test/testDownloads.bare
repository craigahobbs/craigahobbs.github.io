function testDownloadsDataYears():
    unittestDeepEqual(downloadsDataYears(testDownloadsData(), 1), testDownloadsData())

    # The current year includes January 1st
    data = downloadsDataYears(testDownloadsData(), 0)
    unittestDeepEqual(data, testDownloadsData(datetimeNew(2024, 1, 1)))
    unittestEqual(objectGet(arrayGet(data, 0), 'Date'), datetimeNew(2024, 1, 1))
endfunction
unittestRunTest('testDownloadsDataYears')


