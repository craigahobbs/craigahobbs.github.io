include <args.bare>
include <dataLineChart.bare>
include <dataTable.bare>
include <unittest.bare>
include <unittestMock.bare>

include '../downloads.bare'


#
# Test helpers
#


# The test downloads.json rows - "alpha" is published in both languages, "beta" only in Python
testDownloadsRows = [ \
    ['alpha', 'Python', '2023-12-31', 100], \
    ['alpha', 'Python', '2024-01-01', 1], \
    ['alpha', 'Python', '2024-01-31', 2], \
    ['alpha', 'Python', '2024-02-01', 3], \
    ['beta', 'Python', '2024-02-01', 7], \
    ['alpha', 'JavaScript', '2024-02-02', 10], \
    ['alpha', 'Python', '2024-02-02', 4], \
    ['alpha', 'JavaScript', '2024-02-03', 20], \
    ['alpha', 'Python', '2024-02-03', 5] \
]


# The test downloads.json text
function testDownloadsJSON():
    rows = []
    for row in testDownloadsRows:
        arrayPush(rows, { \
            'Package': arrayGet(row, 0), \
            'Language': arrayGet(row, 1), \
            'Date': arrayGet(row, 2), \
            'Downloads': arrayGet(row, 3) \
        })
    endfor
    return jsonStringify(rows, 4)
endfunction


# The test mock data
function testDownloadsMockData():
    return {'systemFetch': {'downloads.json': testDownloadsJSON()}}
endfunction


# The test data as loaded by downloadsDataLoad, optionally starting at a minimum date
function testDownloadsData(minDate):
    data = []
    for row in testDownloadsRows:
        package = arrayGet(row, 0)
        language = arrayGet(row, 1)
        date = datetimeISOParse(arrayGet(row, 2))
        if minDate == null || date >= minDate:
            arrayPush(data, { \
                'Package': package, \
                'Language': language, \
                'Date': date, \
                'Downloads': arrayGet(row, 3), \
                'Unique': if(package == 'beta', 'beta', package + if(language == 'Python', ' (py)', ' (js)')) \
            })
        endif
    endfor
    return data
endfunction


# Helper to create a downloadsDataAverage/downloadsDataMonthly row
function testDownloadsAggregateRow(package, language, unique, downloads, month):
    row = {'Language': language, 'Package': package, 'Unique': unique, 'Downloads': downloads}
    if month != null:
        objectSet(row, 'Month', month)
    endif
    return row
endfunction


# Helper to reset the URL argument globals
function testDownloadsResetGlobals():
    for argument in downloadsArguments:
        systemGlobalSet('v' + stringUpper(stringSlice(objectGet(argument, 'name'), 0, 1)) + stringSlice(objectGet(argument, 'name'), 1), null)
    endfor
endfunction


# Helper to verify a windowSetResize callback has the same effect as the expected function
async function testDownloadsVerifyResize(calls, expectedFn):
    resizeFn = null
    for call in calls:
        if arrayGet(call, 0) == 'windowSetResize':
            resizeFn = arrayGet(arrayGet(call, 1), 0)
        endif
    endfor

    unittestMockAll(testDownloadsMockData())
    expectedFn()
    expected = unittestMockEnd()
    unittestMockAll(testDownloadsMockData())
    resizeFn()
    unittestDeepEqual(unittestMockEnd(), expected)
endfunction


#
# downloadsDataLoad
#


async function testDownloadsDataLoad():
    unittestMockAll(testDownloadsMockData())
    data = downloadsDataLoad()
    unittestDeepEqual(unittestMockEnd(), [ \
        ['systemFetch', ['downloads.json']] \
    ])
    unittestDeepEqual(data, testDownloadsData())
endfunction
unittestRunTest('testDownloadsDataLoad')


async function testDownloadsDataLoadFetchError():
    unittestMockAll({})
    data = downloadsDataLoad()
    unittestDeepEqual(unittestMockEnd(), [ \
        ['systemFetch', ['downloads.json']], \
        ['markdownPrint', ['', '**Error:** Failed to load downloads data']] \
    ])
    unittestEqual(data, null)
endfunction
unittestRunTest('testDownloadsDataLoadFetchError')


#
# downloadsDataAverage
#


function testDownloadsDataAverage():
    # The 3-day trailing window is 2024-02-01 through 2024-02-03
    unittestDeepEqual(downloadsDataAverage(testDownloadsData(), 3, true), [ \
        testDownloadsAggregateRow('alpha', 'Python', 'alpha (py)', 12 * 30 / 3), \
        testDownloadsAggregateRow('beta', 'Python', 'beta', 7 * 30 / 3), \
        testDownloadsAggregateRow('alpha', 'JavaScript', 'alpha (js)', 30 * 30 / 3) \
    ])
    unittestDeepEqual(downloadsDataAverage(testDownloadsData(), 3, false), [ \
        testDownloadsAggregateRow('alpha', 'Python', 'alpha (py)', 12 / 3), \
        testDownloadsAggregateRow('beta', 'Python', 'beta', 7 / 3), \
        testDownloadsAggregateRow('alpha', 'JavaScript', 'alpha (js)', 30 / 3) \
    ])
endfunction
unittestRunTest('testDownloadsDataAverage')


function testDownloadsDataAverageZero():
    # A package with no downloads in the trailing window has a zero average
    unittestDeepEqual(downloadsDataAverage(testDownloadsData(), 1, true), [ \
        testDownloadsAggregateRow('alpha', 'Python', 'alpha (py)', 5 * 30), \
        testDownloadsAggregateRow('beta', 'Python', 'beta', 0), \
        testDownloadsAggregateRow('alpha', 'JavaScript', 'alpha (js)', 20 * 30) \
    ])
endfunction
unittestRunTest('testDownloadsDataAverageZero')


function testDownloadsDataAverageMinDate():
    unittestEqual(downloadsDataAverageMinDate(testDownloadsData(), 3), datetimeNew(2024, 1, 31))
    unittestEqual( \
        downloadsDataAverageMinDate([{'Month': datetimeNew(2024, 1, 1)}, {'Month': datetimeNew(2024, 2, 1)}], 3, 'Month'), \
        datetimeNew(2024, 1, 29) \
    )
endfunction
unittestRunTest('testDownloadsDataAverageMinDate')


#
# downloadsDataYears
#


function testDownloadsDataYears():
    unittestDeepEqual(downloadsDataYears(testDownloadsData(), 1), testDownloadsData())

    # The current year includes January 1st
    data = downloadsDataYears(testDownloadsData(), 0)
    unittestDeepEqual(data, testDownloadsData(datetimeNew(2024, 1, 1)))
    unittestEqual(objectGet(arrayGet(data, 0), 'Date'), datetimeNew(2024, 1, 1))
endfunction
unittestRunTest('testDownloadsDataYears')


#
# downloadsDataMonthly
#


function testDownloadsDataMonthly():
    unittestDeepEqual(downloadsDataMonthly(testDownloadsData()), [ \
        testDownloadsAggregateRow('alpha', 'Python', 'alpha (py)', 100, datetimeNew(2023, 12, 1)), \
        testDownloadsAggregateRow('alpha', 'Python', 'alpha (py)', 3, datetimeNew(2024, 1, 1)), \
        testDownloadsAggregateRow('alpha', 'Python', 'alpha (py)', 12, datetimeNew(2024, 2, 1)), \
        testDownloadsAggregateRow('beta', 'Python', 'beta', 7, datetimeNew(2024, 2, 1)), \
        testDownloadsAggregateRow('alpha', 'JavaScript', 'alpha (js)', 30, datetimeNew(2024, 2, 1)) \
    ])
endfunction
unittestRunTest('testDownloadsDataMonthly')


function testDownloadsDataMonthlyCurrentMonth():
    # The current (partial) month is excluded
    today = datetimeToday()
    lastMonth = datetimeNew(datetimeYear(today), datetimeMonth(today) - 1, 1)
    data = [ \
        {'Package': 'beta', 'Language': 'Python', 'Unique': 'beta', 'Date': lastMonth, 'Downloads': 1}, \
        {'Package': 'beta', 'Language': 'Python', 'Unique': 'beta', 'Date': today, 'Downloads': 2} \
    ]
    unittestDeepEqual(downloadsDataMonthly(data), [ \
        testDownloadsAggregateRow('beta', 'Python', 'beta', 1, lastMonth) \
    ])
endfunction
unittestRunTest('testDownloadsDataMonthlyCurrentMonth')


