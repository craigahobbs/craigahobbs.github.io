#
# Package dashboard page
#


# The package dashboard page's header calls
function testDownloadsDashboardHeader(name, language, linkArgs, yearsControls):
    title = name + ' (' + language + ') Downloads'
    nameArgs = "var.vLanguage='" + language + "'&var.vName='" + name + "'"
    return [ \
        ['markdownPrint', [ \
            '[Back](#' + if(linkArgs, linkArgs, 'var=') + ')', \
            '', \
            '# ' + name + ' \\(' + language + '\\) Downloads', \
            '', \
            if(yearsControls, yearsControls, [ \
                '**Showing:** 1 year', \
                '([Fewer](#' + if(linkArgs, linkArgs + '&', '') + nameArgs + '&var.vYears=0) | ', \
                '[More](#' + if(linkArgs, linkArgs + '&', '') + nameArgs + '&var.vYears=2))' \
            ]) \
        ]], \
        ['documentSetTitle', [title]], \
        ['systemFetch', ['downloads.json']] \
    ]
endfunction


# The package dashboard page's chart and table calls
function testDownloadsDashboardCharts(name, dataMonthly, monthlyAverage, monthlyMinDate, data, dailyMinDate, tableRows):
    return [ \
        ['elementModelRender', [{'html': 'p', 'elem': dataLineChartElements(dataMonthly, { \
            'title': 'Monthly Downloads - ' + name, \
            'width': 768, \
            'height': 240, \
            'x': 'Month', \
            'y': ['Downloads'], \
            'xLines': [{'value': monthlyMinDate, 'label': ''}], \
            'yLines': [{'value': monthlyAverage}] \
        }, {'fontSize': 16})}]], \
        ['elementModelRender', [{'html': 'p', 'elem': dataLineChartElements(data, { \
            'title': 'Daily Downloads - ' + name, \
            'width': 960, \
            'height': 240, \
            'x': 'Date', \
            'y': ['Average Downloads', 'Downloads'], \
            'xLines': [{'value': dailyMinDate, 'label': ''}], \
            'yLines': [{'value': monthlyAverage / 30}] \
        }, {'fontSize': 16})}]], \
        ['elementModelRender', [{'html': 'p', 'elem': dataTableElements(tableRows, { \
            'fields': ['Month', 'Downloads', '% Average'], \
            'formats': { \
                'Downloads': {'align': 'right'} \
            }, \
            'datetime': 'month', \
            'precision': 0 \
        })}]], \
        ['windowSetResize', ['<function>']] \
    ]
endfunction


async function testDownloadsMainDashboard():
    systemGlobalSet('vName', 'alpha')
    systemGlobalSet('vLanguage', 'Python')
    systemGlobalSet('vDays', 3)
    unittestMockAll(testDownloadsMockData())
    downloadsMain({})
    calls = unittestMockEnd()

    # The package's daily data with the 3-day trailing average - the first full window ends 2024-01-02
    data = dataFilter(testDownloadsData(), 'Package == "alpha" && Language == "Python"')
    dataCalculatedField(data, 'Month', 'datetimeNew(datetimeYear(Date), datetimeMonth(Date), 1)')
    objectSet(arrayGet(data, 2), 'Average Downloads', 2 / 3)
    objectSet(arrayGet(data, 3), 'Average Downloads', 5 / 3)
    objectSet(arrayGet(data, 4), 'Average Downloads', 9 / 3)
    objectSet(arrayGet(data, 5), 'Average Downloads', 12 / 3)

    unittestDeepEqual(calls, arrayExtend(testDownloadsDashboardHeader('alpha', 'Python', 'var.vDays=3'), \
        testDownloadsDashboardCharts( \
            'alpha', \
            [ \
                testDownloadsAggregateRow('alpha', 'Python', 'alpha (py)', 100, datetimeNew(2023, 12, 1)), \
                testDownloadsAggregateRow('alpha', 'Python', 'alpha (py)', 3, datetimeNew(2024, 1, 1)), \
                testDownloadsAggregateRow('alpha', 'Python', 'alpha (py)', 12, datetimeNew(2024, 2, 1)) \
            ], \
            120, \
            datetimeNew(2024, 1, 29), \
            data, \
            datetimeNew(2024, 1, 31), \
            [ \
                {'Month': datetimeNew(2024, 2, 1), 'Downloads': 12, '% Average': '-90%'}, \
                {'Month': datetimeNew(2024, 1, 1), 'Downloads': 3, '% Average': '-97.5%'}, \
                {'Month': datetimeNew(2023, 12, 1), 'Downloads': 100, '% Average': '-16.7%'} \
            ] \
        ) \
    ))

    # The resize callback re-renders the dashboard page
    args = argsParse(downloadsArguments)
    testDownloadsVerifyResize(calls, systemPartial(downloadsDashboard, args))
    testDownloadsResetGlobals()
endfunction
unittestRunTest('testDownloadsMainDashboard')


async function testDownloadsMainDashboardCurrentYear():
    # The trailing average uses the data before the current year, so it starts on January 1st
    systemGlobalSet('vName', 'alpha')
    systemGlobalSet('vLanguage', 'Python')
    systemGlobalSet('vDays', 2)
    systemGlobalSet('vYears', 0)
    unittestMockAll(testDownloadsMockData())
    downloadsMain({})
    calls = unittestMockEnd()

    # The package's current-year daily data with the 2-day trailing average
    data = dataFilter(testDownloadsData(datetimeNew(2024, 1, 1)), 'Package == "alpha" && Language == "Python"')
    dataCalculatedField(data, 'Month', 'datetimeNew(datetimeYear(Date), datetimeMonth(Date), 1)')
    objectSet(arrayGet(data, 0), 'Average Downloads', (100 + 1) / 2)
    objectSet(arrayGet(data, 1), 'Average Downloads', 2 / 2)
    objectSet(arrayGet(data, 2), 'Average Downloads', (2 + 3) / 2)
    objectSet(arrayGet(data, 3), 'Average Downloads', (3 + 4) / 2)
    objectSet(arrayGet(data, 4), 'Average Downloads', (4 + 5) / 2)

    nameArgs = "var.vDays=2&var.vLanguage='Python'&var.vName='alpha'"
    unittestDeepEqual(calls, arrayExtend( \
        testDownloadsDashboardHeader('alpha', 'Python', 'var.vDays=2&var.vYears=0', [ \
            '**Showing:** Current', \
            '([Fewer](#' + nameArgs + '&var.vYears=0) | ', \
            '[More](#' + nameArgs + '))' \
        ]), \
        testDownloadsDashboardCharts( \
            'alpha', \
            [ \
                testDownloadsAggregateRow('alpha', 'Python', 'alpha (py)', 3, datetimeNew(2024, 1, 1)), \
                testDownloadsAggregateRow('alpha', 'Python', 'alpha (py)', 12, datetimeNew(2024, 2, 1)) \
            ], \
            135, \
            datetimeNew(2024, 1, 30), \
            data, \
            datetimeNew(2024, 2, 1), \
            [ \
                {'Month': datetimeNew(2024, 2, 1), 'Downloads': 12, '% Average': '-91.1%'}, \
                {'Month': datetimeNew(2024, 1, 1), 'Downloads': 3, '% Average': '-97.8%'} \
            ] \
        ) \
    ))
    testDownloadsResetGlobals()
endfunction
unittestRunTest('testDownloadsMainDashboardCurrentYear')


async function testDownloadsMainDashboardZeroAverage():
    # The package has no downloads in the 1-day trailing window
    systemGlobalSet('vName', 'beta')
    systemGlobalSet('vLanguage', 'Python')
    systemGlobalSet('vDays', 1)
    unittestMockAll(testDownloadsMockData())
    downloadsMain({})
    calls = unittestMockEnd()

    data = dataFilter(testDownloadsData(), 'Package == "beta"')
    objectSet(arrayGet(data, 0), 'Month', datetimeNew(2024, 2, 1))
    objectSet(arrayGet(data, 0), 'Average Downloads', 7)

    unittestDeepEqual(calls, arrayExtend(testDownloadsDashboardHeader('beta', 'Python', 'var.vDays=1'), \
        testDownloadsDashboardCharts( \
            'beta', \
            [testDownloadsAggregateRow('beta', 'Python', 'beta', 7, datetimeNew(2024, 2, 1))], \
            0, \
            datetimeNew(2024, 1, 31), \
            data, \
            datetimeNew(2024, 1, 31), \
            [{'Month': datetimeNew(2024, 2, 1), 'Downloads': 7, '% Average': ''}] \
        ) \
    ))
    testDownloadsResetGlobals()
endfunction
unittestRunTest('testDownloadsMainDashboardZeroAverage')


