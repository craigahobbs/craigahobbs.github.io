#
# Chart page
#


# The chart page's header calls
function testDownloadsChartHeader():
    return [ \
        ['documentSetTitle', ['Downloads Chart']], \
        ['markdownPrint', [ \
            '[Back](#var=)', \
            '', \
            '# Downloads Chart', \
            '', \
            [ \
                '**Showing:** 1 year', \
                "([Fewer](#var.vPage='chart'&var.vYears=0) | ", \
                "[More](#var.vPage='chart'&var.vYears=2))" \
            ] \
        ]], \
        ['systemFetch', ['downloads.json']] \
    ]
endfunction


# The chart page's line chart elements
function testDownloadsChart(title, data):
    return ['elementModelRender', [{'html': 'p', 'elem': dataLineChartElements(data, { \
        'title': title, \
        'width': 960, \
        'height': 288, \
        'x': 'Month', \
        'y': ['Downloads'], \
        'color': 'Unique' \
    }, {'fontSize': 16})}]]
endfunction


async function testDownloadsMainChart():
    systemGlobalSet('vPage', 'chart')
    options = {'featured': {'beta': {'Python': true}, 'alpha': {'JavaScript': false}}}
    unittestMockAll(testDownloadsMockData())
    downloadsMain(options)
    calls = unittestMockEnd()
    unittestDeepEqual(calls, arrayExtend(testDownloadsChartHeader(), [ \
        testDownloadsChart('Monthly Downloads (Featured)', [ \
            testDownloadsAggregateRow('beta', 'Python', 'beta', 7, datetimeNew(2024, 2, 1)) \
        ]), \
        testDownloadsChart('Monthly Downloads', [ \
            testDownloadsAggregateRow('alpha', 'Python', 'alpha (py)', 100, datetimeNew(2023, 12, 1)), \
            testDownloadsAggregateRow('alpha', 'Python', 'alpha (py)', 3, datetimeNew(2024, 1, 1)), \
            testDownloadsAggregateRow('alpha', 'Python', 'alpha (py)', 12, datetimeNew(2024, 2, 1)), \
            testDownloadsAggregateRow('alpha', 'JavaScript', 'alpha (js)', 30, datetimeNew(2024, 2, 1)) \
        ]), \
        ['windowSetResize', ['<function>']] \
    ]))

    # The resize callback re-renders the chart page
    args = argsParse(downloadsArguments)
    testDownloadsVerifyResize(calls, systemPartial(downloadsChartPage, args, options))
    testDownloadsResetGlobals()
endfunction
unittestRunTest('testDownloadsMainChart')


async function testDownloadsMainChartNoFeatured():
    systemGlobalSet('vPage', 'chart')
    unittestMockAll(testDownloadsMockData())
    downloadsMain({})
    unittestDeepEqual(unittestMockEnd(), arrayExtend(testDownloadsChartHeader(), [ \
        testDownloadsChart('Monthly Downloads', downloadsDataMonthly(testDownloadsData())), \
        ['windowSetResize', ['<function>']] \
    ]))
    testDownloadsResetGlobals()
endfunction
unittestRunTest('testDownloadsMainChartNoFeatured')


