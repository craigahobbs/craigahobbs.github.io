#
# Index page
#


# Helper to create an expected argsLink link from the URL arguments and overrides
function testDownloadsLink(text, linkArgs, overrides):
    linkArgs = objectCopy(linkArgs)
    objectAssign(linkArgs, overrides)
    parts = []
    for name in arraySort(objectKeys(linkArgs)):
        value = objectGet(linkArgs, name)
        if value != null && !(name == 'days' && value == 90) && !(name == 'years' && value == 1):
            arrayPush(parts, 'var.' + testDownloadsGlobalName(name) + '=' + \
                if(systemType(value) == 'string', "'" + value + "'", value))
        endif
    endfor
    return '[' + text + '](#' + if(parts, arrayJoin(parts, '&'), 'var=') + ')'
endfunction


# Helper to create an expected filter links line - values are [value, text] pairs, the current value is bold
function testDownloadsFilterLinks(label, argName, values, linkArgs):
    links = []
    for value in values:
        linkText = arrayGet(value, 1)
        arrayPush(links, if(arrayGet(value, 0) == objectGet(linkArgs, argName), '**' + linkText + '**', \
            testDownloadsLink(linkText, linkArgs, {argName: arrayGet(value, 0)})))
    endfor
    return '**' + label + ':** ' + arrayJoin(links, ' | ')
endfunction


# The index page's header calls
function testDownloadsIndexHeader(linkArgs):
    years = mathMax(0, objectGet(linkArgs, 'years', 1))
    return [ \
        ['markdownPrint', [ \
            '# Package Downloads', \
            '', \
            [ \
                '**Showing:** ' + if(years == 0, 'Current', if(years == 1, '1 year', years + ' years')), \
                '(' + testDownloadsLink('Fewer', linkArgs, {'years': mathMax(0, years - 1)}) + ' | ', \
                testDownloadsLink('More', linkArgs, {'years': years + 1}) + ')' \
            ], \
            '', \
            testDownloadsFilterLinks('Language', 'language', \
                [[null, 'All'], ['Python', 'Python'], ['JavaScript', 'JavaScript']], linkArgs), \
            '', \
            testDownloadsFilterLinks('Downloads', 'rank', [[null, 'All'], ['top', 'Top'], ['bottom', 'Bottom']], linkArgs) \
        ]], \
        ['documentSetTitle', ['Package Downloads']], \
        ['systemFetch', ['downloads.json']] \
    ]
endfunction


# The test data with the 30-day trailing average - only "alpha (py)" has a full window, the first ending 2024-01-29
function testDownloadsChartData():
    data = testDownloadsData()
    objectSet(arrayGet(data, 2), 'Average Downloads', 2 / 30)
    objectSet(arrayGet(data, 3), 'Average Downloads', (2 + 3) / 30)
    objectSet(arrayGet(data, 6), 'Average Downloads', (2 + 3 + 4) / 30)
    objectSet(arrayGet(data, 8), 'Average Downloads', (2 + 3 + 4 + 5) / 30)
    return data
endfunction


# The index page's line chart elements - only the rows with a positive trailing average are charted
function testDownloadsChart(data, days):
    days = if(days, days, 30)
    return ['elementModelRender', [{'html': 'p', 'elem': dataLineChartElements(dataFilter(data, '[Average Downloads] > 0'), { \
        'title': 'Daily Downloads (' + days + '-Day Average)', \
        'width': 960, \
        'height': 480, \
        'x': 'Date', \
        'y': ['Average Downloads'], \
        'color': 'Unique', \
        'yScale': 'log' \
    }, {'fontSize': 16})}]]
endfunction


# The index page's downloads table elements - rows are [package, language, downloads]
function testDownloadsIndexTable(rows, total, linkArgs):
    tableRows = []
    for row in rows:
        package = arrayGet(row, 0)
        language = arrayGet(row, 1)
        arrayPush(tableRows, { \
            'Package': testDownloadsLink(package, linkArgs, {'name': package, 'language': language}), \
            'Language': if(language == 'Python', \
                '[Python](https://pypi.org/project/' + package + '/)', \
                '[JavaScript](https://www.npmjs.com/package/' + package + ')' \
            ), \
            'Unique': testDownloadsUnique(package, language), \
            'Downloads': arrayGet(row, 2) \
        })
    endfor
    arrayPush(tableRows, {'Package': '**Total**', 'Language': '', 'Downloads': total})
    return ['elementModelRender', [{'html': 'p', 'elem': dataTableElements(tableRows, { \
        'fields': ['Package', 'Language', 'Downloads'], \
        'formats': { \
            'Package': {'markdown': true}, \
            'Language': {'markdown': true}, \
            'Downloads': {'align': 'right', 'header': 'Monthly Downloads'} \
        }, \
        'precision': 0 \
    })}]]
endfunction


# The index page's calls - the table rows and total default to the 90-day monthly averages
function testDownloadsIndexCalls(linkArgs, chartCalls, tableRows, tableTotal):
    if tableRows == null:
        tableRows = [ \
            ['alpha', 'Python', 115 * 30 / 90], \
            ['alpha', 'JavaScript', 30 * 30 / 90], \
            ['beta', 'Python', 7 * 30 / 90] \
        ]
        tableTotal = 115 * 30 / 90 + 7 * 30 / 90 + 30 * 30 / 90
    endif
    return arrayExtend(arrayExtend(testDownloadsIndexHeader(linkArgs), chartCalls), [ \
        testDownloadsIndexTable(tableRows, tableTotal, linkArgs), \
        ['windowSetResize', ['<function>']] \
    ])
endfunction


async function testDownloadsMainIndex():
    systemGlobalSet('vDays', 3)
    unittestMockAll(testDownloadsMockData())
    downloadsMain()
    calls = unittestMockEnd()
    unittestDeepEqual(calls, testDownloadsIndexCalls( \
        {'days': 3}, \
        [testDownloadsChart(testDownloadsChartData())], \
        [['alpha', 'JavaScript', 300], ['alpha', 'Python', 120], ['beta', 'Python', 70]], \
        490 \
    ))

    # The resize callback re-renders the index page
    args = argsParse(downloadsArguments)
    testDownloadsVerifyResize(calls, systemPartial(downloadsIndex, args))
    testDownloadsResetGlobals()
endfunction
unittestRunTest('testDownloadsMainIndex')


async function testDownloadsMainIndexClamp():
    # Out-of-range days and years are clamped to 1 day and the current year - the current year's chart
    # has the same trailing averages
    systemGlobalSet('vDays', 0)
    systemGlobalSet('vYears', -2)
    unittestMockAll(testDownloadsMockData())
    downloadsMain()
    unittestDeepEqual(unittestMockEnd(), testDownloadsIndexCalls( \
        {'days': 0, 'years': -2}, \
        [testDownloadsChart(testDownloadsChartData())], \
        [['alpha', 'JavaScript', 600], ['alpha', 'Python', 150], ['beta', 'Python', 0]], \
        750 \
    ))
    testDownloadsResetGlobals()
endfunction
unittestRunTest('testDownloadsMainIndexClamp')


