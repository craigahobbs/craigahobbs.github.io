endfunction
unittestRunTest('testDownloadsYearsControls')


#
# Index page
#


# The index page's downloads table elements
function testDownloadsIndexTable(rows, total, linkPrefix, linkSuffix):
    tableRows = []
    for row in rows:
        package = arrayGet(row, 0)
        language = arrayGet(row, 1)
        arrayPush(tableRows, { \
            'Package': '[' + package + '](#' + linkPrefix + "var.vLanguage='" + language + "'&var.vName='" + package + "'" + \
                if(linkSuffix, linkSuffix, '') + ')', \
            'Language': if(language == 'Python', \
                '[Python](https://pypi.org/project/' + package + '/)', \
                '[JavaScript](https://www.npmjs.com/package/' + package + ')' \
            ), \
            'Unique': arrayGet(row, 2), \
            'Downloads': arrayGet(row, 3) \
        })
    endfor
    arrayPush(tableRows, {'Package': '**Total**', 'Language': '', 'Downloads': total})
    return {'html': 'p', 'elem': dataTableElements(tableRows, { \
        'fields': ['Package', 'Language', 'Downloads'], \
        'formats': { \
            'Package': {'markdown': true}, \
            'Language': {'markdown': true}, \
            'Downloads': {'align': 'right', 'header': 'Monthly Downloads'} \
        }, \
        'precision': 0 \
    })}
endfunction


async function testDownloadsMainIndex():
    systemGlobalSet('vDays', 3)
    unittestMockAll(testDownloadsMockData())
    downloadsMain({})
    unittestDeepEqual(unittestMockEnd(), [ \
        ['markdownPrint', [ \
            '# Package Downloads', \
            '', \
            [ \
                '**Showing:** 1 year', \
                '([Fewer](#var.vDays=3&var.vYears=0) | ', \
                '[More](#var.vDays=3&var.vYears=2))' \
            ], \
            '', \
            "[Time Chart](#var.vDays=3&var.vPage='chart')" \
        ]], \
        ['documentSetTitle', ['Package Downloads']], \
        ['systemFetch', ['downloads.json']], \
        ['elementModelRender', [testDownloadsIndexTable([ \
            ['alpha', 'JavaScript', 'alpha (js)', 300], \
            ['alpha', 'Python', 'alpha (py)', 120], \
            ['beta', 'Python', 'beta', 70] \
        ], 490, 'var.vDays=3&')]] \
    ])
    testDownloadsResetGlobals()
endfunction
unittestRunTest('testDownloadsMainIndex')


async function testDownloadsMainIndexClamp():
    # Out-of-range days and years are clamped to 1 day and the current year
    systemGlobalSet('vDays', 0)
    systemGlobalSet('vYears', -2)
    unittestMockAll(testDownloadsMockData())
    downloadsMain({})
    unittestDeepEqual(unittestMockEnd(), [ \
        ['markdownPrint', [ \
            '# Package Downloads', \
            '', \
            [ \
                '**Showing:** Current', \
                '([Fewer](#var.vDays=0&var.vYears=0) | ', \
                '[More](#var.vDays=0))' \
            ], \
            '', \
            "[Time Chart](#var.vDays=0&var.vPage='chart'&var.vYears=-2)" \
        ]], \
        ['documentSetTitle', ['Package Downloads']], \
        ['systemFetch', ['downloads.json']], \
        ['elementModelRender', [testDownloadsIndexTable([ \
            ['alpha', 'JavaScript', 'alpha (js)', 600], \
            ['alpha', 'Python', 'alpha (py)', 150], \
            ['beta', 'Python', 'beta', 0] \
        ], 750, 'var.vDays=0&', '&var.vYears=-2')]] \
    ])
    testDownloadsResetGlobals()
endfunction
unittestRunTest('testDownloadsMainIndexClamp')


