        testDownloadsAggregateRow('alpha', 'Python', 'alpha (py)', 3, datetimeNew(2024, 1, 1)), \
        testDownloadsAggregateRow('alpha', 'Python', 'alpha (py)', 12, datetimeNew(2024, 2, 1)), \
        testDownloadsAggregateRow('beta', 'Python', 'beta', 7, datetimeNew(2024, 2, 1)), \
        testDownloadsAggregateRow('alpha', 'JavaScript', 'alpha (js)', 30, datetimeNew(2024, 2, 1)) \
    ])
