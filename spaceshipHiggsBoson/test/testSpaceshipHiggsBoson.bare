function testPageHelpers():
    unittestEqual(shbPageGet('warp'), null)
    unittestEqual(objectGet(shbPageGet('about'), 'title'), 'About')
    unittestEqual(shbControlRows('video', testWidth), 1)
    unittestEqual(shbControlRows('viewer', testWidth), 1)
    unittestEqual(shbControlRows('viewer', 400), 3)

    # The canvas is at least 320 pixels square
    testMockAll()
    unittestMockOne('windowWidth', systemPartial(testReturn, 200))
    unittestMockOne('windowHeight', systemPartial(testReturn, 200))
    unittestDeepEqual(shbCanvasSize(), {'width': 320, 'height': 320})
    unittestMockEnd()
endfunction
unittestRunTest('testPageHelpers')


