function testQualityDetect():
    testMockAll()
    unittestEqual(shbQualityDetect(testWidth, testHeight), 3)
    unittestEqual(shbQualityDetect(500, 500), 1)
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testQualityDetect')


function testQualityPick():
    pixels = testWidth * testHeight
    unittestEqual(shbQualityPick(0.009, pixels), 3)
    unittestEqual(shbQualityPick(0.011, pixels), 2)
    unittestEqual(shbQualityPick(0.015, pixels), 1)
    unittestEqual(shbQualityPick(1, pixels), 0)
    unittestEqual(shbQualityPick(0.001, 300000), 1)
    unittestEqual(shbQualityPick(0.001, 5000000), 2)
endfunction
unittestRunTest('testQualityPick')


function testQualityAdaptFixed():
    state = {'quality': 'high', 'level': 2, 'perf': shbPerfNew()}
    shbQualityAdapt(state, 100)
    unittestDeepEqual(state, {'quality': 'high', 'level': 2, 'perf': shbPerfNew()})

    # Throttled frames (e.g. a background tab) are ignored
    objectSet(state, 'quality', 'auto')
    shbQualityAdapt(state, 1500)
    unittestDeepEqual(state, {'quality': 'auto', 'level': 2, 'perf': shbPerfNew()})
endfunction
unittestRunTest('testQualityAdaptFixed')


function testFrameBudget():
    # The frame rate targets - Low 12 fps, Medium 10, High 8, and Ultra 7
    unittestDeepEqual([numberToFixed(shbFrameBudget(0), 1), shbFrameBudget(1), shbFrameBudget(2), numberToFixed(shbFrameBudget(3), 1)], \
        ['43.3', 60, 85, '102.9'])
endfunction
unittestRunTest('testFrameBudget')


function testQualityAdaptDown():
    # High's budget is 85 ms
    state = {'quality': 'auto', 'level': 2, 'perf': shbPerfNew()}
    frame = 0
    while frame < 7:
        shbQualityAdapt(state, 100)
        frame = frame + 1
    endwhile
    unittestEqual(objectGet(state, 'level'), 2)
    unittestDeepEqual(objectGet(state, 'perf'), {'average': 100, 'samples': 7, 'fastFrames': 0})
    shbQualityAdapt(state, 100)
    unittestDeepEqual(state, {'quality': 'auto', 'level': 1, 'perf': shbPerfNew()})

    # The lowest level stays
    objectSet(state, 'level', 0)
    frame = 0
    while frame < 10:
        shbQualityAdapt(state, 100)
        frame = frame + 1
    endwhile
    unittestEqual(objectGet(state, 'level'), 0)
endfunction
unittestRunTest('testQualityAdaptDown')


function testQualityAdaptUp():
    # From Medium, High's estimated cost (twice Medium's faces) must fit in 80% of its 85 ms budget
    state = {'quality': 'auto', 'level': 1, 'perf': shbPerfNew()}
    frame = 0
    while frame < 49:
        shbQualityAdapt(state, 2)
        frame = frame + 1
    endwhile
    unittestEqual(objectGet(state, 'level'), 1)
    unittestEqual(objectGet(objectGet(state, 'perf'), 'fastFrames'), 49)

    # A slower frame resets the fast-frame run
    shbQualityAdapt(state, 300)
    unittestEqual(objectGet(objectGet(state, 'perf'), 'fastFrames'), 0)
    perf = objectGet(state, 'perf')
    objectSet(perf, 'average', 2)
    objectSet(perf, 'fastFrames', 49)
    shbQualityAdapt(state, 2)
    unittestDeepEqual(state, {'quality': 'auto', 'level': 2, 'perf': shbPerfNew()})

    # The highest level stays
    objectSet(state, 'level', 3)
    frame = 0
    while frame < 60:
        shbQualityAdapt(state, 2)
        frame = frame + 1
    endwhile
    unittestEqual(objectGet(state, 'level'), 3)
    unittestEqual(objectGet(objectGet(state, 'perf'), 'fastFrames'), 0)
endfunction
unittestRunTest('testQualityAdaptUp')


function testQualityText():
    unittestEqual(shbQualityText({'quality': 'auto', 'level': 2}), 'Detail: High (auto)')
    unittestEqual(shbQualityText({'quality': 'ultra', 'level': 3}), 'Detail: Ultra')
    unittestEqual(shbFrameRateText({'playing': true, 'perf': {'average': 10}}), '20 fps')
    unittestEqual(shbFrameRateText({'playing': true, 'perf': {'average': -5}}), '25 fps')
    unittestEqual(shbFrameRateText({'playing': true, 'perf': {'average': null}}), '')
    unittestEqual(shbFrameRateText({'playing': false, 'perf': {'average': 10}}), '')
    unittestEqual(shbStatusText({'quality': 'low', 'level': 0, 'playing': false, 'perf': {'average': 10}}), 'Detail: Low · Paused')
    unittestEqual(shbStatusText({'quality': 'low', 'level': 0, 'playing': true, 'perf': {'average': 10}}), 'Detail: Low · 20 fps')
    unittestEqual(shbStatusText({'quality': 'low', 'level': 0, 'playing': true, 'perf': {'average': null}}), 'Detail: Low')
endfunction
unittestRunTest('testQualityText')


