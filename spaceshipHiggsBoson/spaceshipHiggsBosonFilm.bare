# The film's reel - the validated film model and its timeline
shbReel = cinemaReel(shbFilmModel)


# The names of the film's sets
shbFilmSetNames = { \
    'earthClose': 'Earth orbit, close', \
    'earthWide': 'Earth orbit, wide', \
    'voyage': 'Interstellar space', \
    'alphaClose': 'α Centauri Ab, close', \
