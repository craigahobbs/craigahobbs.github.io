    'Surgeon': 'Flight surgeon, Mission Control', \
    'Science': 'Science officer, ' + shbShipName \
}


# The film frame's SVG element model at a time - the letterbox bottom is the height of the bottom bar (with the
# player's controls), and the status is the player's status text
function shbFilmFrame(time, level, width, height, letterboxBottom, status):
    quality = arrayGet(shbQualityLevels, level)
    frame = cinemaFrame(shbReel, time, shbFilmVariables)
    scene = shbFilmScene(frame, quality, shbMeshes(level), width, height)

    # The cinematic overlay and the player's heads-up display
    overlay = cinemaOverlayElements(frame, width, height, { \
        'letterboxTop': 44, \
        'letterboxBottom': letterboxBottom, \
        'fontFamily': shbFontFamily, \
        'textColor': shbTextColor, \
        'accentColor': shbAccentColor, \
        'dimColor': shbTextDim \
    })
    return shbSvg(scene, quality, width, height, 'Film - ' + objectGet(frame, 'sceneTitle'), \
        [overlay, shbFilmHud(frame, width, height, letterboxBottom, status)])
endfunction


# A still of the film at a time, for the storyboard - the frame with its titles, but without fades, letterbox, or
# captions
function shbFilmStill(time, level, width, height):
    quality = arrayGet(shbQualityLevels, level)
    frame = cinemaFrame(shbReel, time, shbFilmVariables)
    objectSet(frame, 'fade', 0)
    objectSet(frame, 'dialogue', null)
    scene = shbFilmScene(frame, quality, shbMeshes(level), width, height)
    overlay = cinemaOverlayElements(frame, width, height, \
        {'fontFamily': shbFontFamily, 'textColor': shbTextColor, 'accentColor': shbAccentColor, 'dimColor': shbTextDim})
    return shbSvg(scene, quality, width, height, 'Still - ' + objectGet(frame, 'sceneTitle'), overlay)
endfunction


# The 3D scene of a film frame - its set and its cast, through the frame's camera
function shbFilmScene(frame, quality, meshes, width, height):
    frameCamera = objectGet(frame, 'camera')
    camera = shbCameraLookAt(objectGet(frameCamera, 'eye'), objectGet(frameCamera, 'target'), width, height, \
        objectGet(frameCamera, 'lens'))

    # The set
    set = objectGet(frame, 'set')
    if set == 'earthClose':
        scene = shbFilmEarthClose(frame, camera, quality, meshes)
    elif set == 'earthWide':
        scene = shbFilmEarthWide(frame, camera, quality, meshes)
    elif set == 'voyage':
        scene = shbFilmVoyage(frame, camera, quality, meshes)
    elif set == 'alphaClose' || set == 'alphaWide':
        scene = shbFilmAlpha(frame, camera, quality, meshes)
    else:
        scene = shbSceneNew(camera, [0, 0, -1])
        shbSceneAddStarfield(scene, quality, 0)
    endif

    # The cast
    ship = objectGet(objectGet(frame, 'actors'), 'ship')
    if ship != null:
        shbFilmShip(scene, frame, ship, quality, meshes)
    endif
    return scene
endfunction


# The ship's portrait - a three-quarter view with the drive running
function shbFilmShipPortrait(width, height):
    state = {'yaw': shbViewerYaw, 'pitch': shbViewerPitch, 'zoom': 1.2, 'spin': 0, 'time': 1, 'drive': true, 'labels': false}
    return shbSvg(shbViewerScene(state, 1, width, height), arrayGet(shbQualityLevels, 1), width, height, shbShipName, null)
endfunction


# The film's billing - its actors' screen names, roles, and portrait functions, portraitFn(width, height)
shbFilmBilling = { \
    'ship': {'name': shbShipName, 'role': "As herself - humanity's first starship", 'portraitFn': shbFilmShipPortrait} \
}


# Format a film time as minutes and seconds (e.g. "2:05")
function shbFilmTime(seconds):
    wholeSeconds = mathFloor(seconds)
    remainder = wholeSeconds % 60
    return mathFloor(wholeSeconds / 60) + ':' + if(remainder < 10, '0', '') + remainder
endfunction


# The film's variables - the values of the dialogue's "{name}" placeholders
function shbFilmVariables(frame):
    mission = shbMission(shbAccelG)
    roundTrip = shbRoundTrip()
    variables = { \
        'earthLeg': numberToFixed(objectGet(mission, 'tTotal'), 1), \
        'shipLeg': numberToFixed(objectGet(mission, 'tauTotal'), 1), \
        'roundEarth': numberToFixed(objectGet(roundTrip, 'earthYears'), 1), \
        'roundCrew': numberToFixed(objectGet(roundTrip, 'crewYears'), 1) \
    }
    scene = objectGet(frame, 'scene')
    if scene == 'outbound' || scene == 'homeward':
        missionState = shbFilmVoyageState(frame)
        objectAssign(variables, { \
            'velocity': numberToFixed(objectGet(missionState, 'beta'), 2), \
            'gamma': numberToFixed(objectGet(missionState, 'gamma'), 2), \
            'delay': numberToFixed(objectGet(missionState, 'x'), 1), \
            'crewYears': numberToFixed(objectGet(mission, 'tauTotal') + shbSurveyMonths / 12 + objectGet(missionState, 'tau'), 1) \
        })
    endif
    return variables
endfunction


# The mission state of a voyage scene's frame - the voyage's ship time scales to the scene's duration
function shbFilmVoyageState(frame):
    mission = shbMission(shbAccelG)
    tau = objectGet(mission, 'tauTotal') * objectGet(frame, 'sceneTime') / objectGet(frame, 'sceneDuration')
    return shbMissionState(mission, tau)
endfunction


#
# Sets
#


# The Earth close-up set - the curve of the Earth below, the atmosphere glowing along the horizon, under a high sun
# or a sun rising over the horizon ahead
function shbFilmEarthClose(frame, camera, quality, meshes):
    frameCamera = objectGet(frame, 'camera')
    eye = objectGet(frameCamera, 'eye')
    target = objectGet(frameCamera, 'target')
    sunrise = objectGet(frame, 'lighting') == 'sunrise'
    if sunrise:
        heading = shbVecNormalize([arrayGet(target, 0) - arrayGet(eye, 0), 0, arrayGet(target, 2) - arrayGet(eye, 2)])
        heading = shbMatApply(shbMatRotY(0.25), heading)
        elevation = -0.5 + 0.035 * objectGet(frame, 'shotTime')
        sunDirection = shbVecAdd(shbVecScale(heading, mathCos(elevation)), [0, mathSin(elevation), 0])
    else:
        sunDirection = shbVecNormalize([0.35, 0.85, 0.4])
    endif
    scene = shbSceneNew(camera, sunDirection)
    shbSceneAddStarfield(scene, quality, 0)
    shbSceneAddSun(scene, sunDirection, if(sunrise, 0.9, 0.5), 'url(#shbSunGlow)', '#fffdf4', null)

    # The Earth below - its polar axis along z, so the ship flies an equatorial ground track that starts over Africa
    # - turning beneath the ship. Only the band of the surface near the ship is drawn.
    earthCenter = [0, -(shbCloseEarthRadius + shbCloseAltitude), 0]
    earthRotation = shbMatMul(shbMatMul(shbMatRotZ(objectGet(frame, 'time') * 0.02), shbMatRotX(-shbPi / 2)), shbMatRotY(-90 * shbDeg))
    earthMatrix = shbMatScale(earthRotation, shbCloseEarthRadius)
    belowShip = [arrayGet(earthRotation, 3), arrayGet(earthRotation, 4), arrayGet(earthRotation, 5)]
    shipLon = mathAtan2(-arrayGet(belowShip, 2), arrayGet(belowShip, 0)) / shbDeg
    shbSceneAddMesh(scene, shbBandWindow(objectGet(meshes, 'earthBand'), shipLon), earthMatrix, earthCenter)
    cloudBand = objectGet(meshes, 'cloudBand')
    if cloudBand != null:
        shbSceneAddMesh(scene, shbBandWindow(cloudBand, shipLon), shbMatScale(earthRotation, shbCloseEarthRadius * 1.0015), \
            earthCenter)
    endif
    shbSceneAddHorizon(scene, earthCenter, shbCloseEarthRadius * 1.002, eye, if(objectGet(quality, 'glow'), 'url(#shbGlow)', null))
    return scene
endfunction


# The Earth wide set - the Earth and the ship's orbit, lit over the camera's left shoulder so the Earth is a sunlit
# globe
function shbFilmEarthWide(frame, camera, quality, meshes):
    scene = shbSceneNew(camera, shbCameraToWorld(camera, [-0.55, 0.5, -0.65]))
    shbSceneAddStarfield(scene, quality, 0)
    shbSceneAddEarth(scene, meshes, [0, 0, 0], objectGet(frame, 'time'), 1)

    # The orbit path
    orbitPoints = []
    segment = 0
    while segment < 90:
        angle = segment * 4 * shbDeg
        arrayPush(orbitPoints, [shbWideOrbitRadius * mathCos(angle), 0, -shbWideOrbitRadius * mathSin(angle)])
        segment = segment + 1
    endwhile
    shbSceneAddPath(scene, orbitPoints, 'rgba(255,210,120,0.5)', 1, '5 4', false, null)
    return scene
endfunction


# The voyage set - outbound to Alpha Centauri and homeward to Earth. Earth recedes into the distance (compressed for
# display), and Alpha Centauri A and B are points of light until the ship arrives.
function shbFilmVoyage(frame, camera, quality, meshes):
    homeward = objectGet(frame, 'scene') == 'homeward'
    missionState = shbFilmVoyageState(frame)
    fraction = objectGet(missionState, 'x') / shbAlphaCentauriLy
    earthFraction = if(homeward, 1 - fraction, fraction)
    alphaFraction = 1 - earthFraction

    # The sunlight comes from the camera's side; the Sun itself is drawn near the Earth
    earthSide = if(homeward, 1, -1)
    scene = shbSceneNew(camera, if(homeward, [-0.7, 0.35, 0.6], [0.7, 0.35, 0.6]))
    shbSceneAddStarfield(scene, quality, objectGet(missionState, 'beta'))
    shbSceneAddSun(scene, [earthSide, 0.06, 0.1], 0.15 + 0.85 * (1 - mathSqrt(earthFraction)), 'url(#shbSunGlow)', '#fffdf4', null)

    # Earth, receding behind or approaching ahead
    earthX = earthSide * (30 + 4000 * mathSqrt(earthFraction))
    shbSceneAddEarth(scene, meshes, [earthX, 0, 0], objectGet(frame, 'time'), 1)
    shbSceneAddLabel(scene, [earthX, shbEarthDisplayRadius + 1.5, 0], 'Earth')

    # Alpha Centauri A and B, brightening as the ship nears them
    alphaScale = 0.08 + 0.5 * (1 - alphaFraction) ** 6
    shbSceneAddSun(scene, [-earthSide, 0.01, 0], alphaScale, 'url(#shbSunGlow)', '#fff6dc', 'α Centauri A & B')
    shbSceneAddSun(scene, [-earthSide, -0.004, 0.006], alphaScale * 0.7, 'url(#shbStarB)', '#ffd6a8', null)

    # The course
    shbSceneAddPath(scene, [[-400, 0, 0], [-60, 0, 0], [-15, 0, 0], [15, 0, 0], [60, 0, 0], [400, 0, 0]], \
        'rgba(255,210,120,0.4)', 1, '6 5', true, null)
    return scene
endfunction


# The Alpha Centauri sets - the gas giant Alpha Centauri Ab and its rings, under two suns, filling the sky on the
# close-up set
function shbFilmAlpha(frame, camera, quality, meshes):
    sunDirection = [0.8, 0.3, 0.3]
    scene = shbSceneNew(camera, sunDirection)
    shbSceneAddStarfield(scene, quality, 0)
    shbSceneAddSun(scene, sunDirection, 0.8, 'url(#shbSunGlow)', '#fffdf4', 'α Centauri A')
    shbSceneAddSun(scene, [0.25, 0.3, 0.92], 0.4, 'url(#shbStarB)', '#ffd6a8', 'α Centauri B')

    # The planet and its rings
    close = objectGet(frame, 'set') == 'alphaClose'
    planetRadius = if(close, 2000, shbGiantRadius)
    planetCenter = if(close, [-500, -1500, -1900], [0, 0, 0])
    planetRotation = shbMatRotY(objectGet(frame, 'sceneTime') * 0.02)
    shbSceneAddMesh(scene, objectGet(meshes, 'giant'), shbMatScale(planetRotation, planetRadius), planetCenter)
    shbSceneAddMesh(scene, objectGet(meshes, 'giantRings'), shbMatScale(shbMatMul(shbMatRotX(0.35), planetRotation), \
        planetRadius), planetCenter)
    if !close:
        shbSceneAddLabel(scene, [0, shbGiantRadius + 1, 0], 'α Centauri Ab')
    endif
    return scene
endfunction


#
# Cast
#


# Draw the ship actor - its modules docking when it's assembling, its bubble and drive by its beats, and flipped
# after its turnover
function shbFilmShip(scene, frame, actor, quality, meshes):
    beats = objectGet(actor, 'beats')
    scale = objectGet(actor, 'scale')
    facing = objectGet(actor, 'facing')
    if objectHas(beats, 'turnover'):
        facing = shbVecScale(facing, -1)
    endif
    matrix = shbMatScale(shbFacingMatrix(facing), scale)
    position = objectGet(actor, 'position')
    if objectHas(beats, 'assemble'):
        assembly = objectGet(beats, 'assemble')
        for part, ixPart in objectGet(meshes, 'shipParts'):
            progress = (assembly - 1 - 2.6 * ixPart) / 3
            if progress > 0:
                ease = 1 - (1 - mathMin(1, progress)) ** 3
                offset = shbMatApply(matrix, shbVecScale(arrayGet(shbAssemblyOffsets, ixPart), 1 - ease))
                shbSceneAddMesh(scene, part, matrix, shbVecAdd(position, offset))
            endif
        endfor
    else:
        ignite = objectHas(beats, 'ignite')
        shbSceneAddShip(scene, meshes, quality, matrix, position, objectGet(frame, 'time'), ignite || objectHas(beats, 'bubble'), ignite)
    endif
    label = objectGet(actor, 'label')
    if label != null:
        shbSceneAddLabel(scene, shbVecAdd(position, [0, 7 * scale, 0]), label)
    endif
endfunction


#
# Heads-up display
#


# The film's heads-up display element model - the scene and status in the top bar, the telemetry, and the timeline
# with scene marks along the top of the bottom bar
function shbFilmHud(frame, width, height, letterboxBottom, status):
    sceneCount = cinemaSceneCount(shbReel)
    hud = [ \
        shbSvgText((objectGet(frame, 'sceneIndex') + 1) + ' / ' + sceneCount + ' · ' + objectGet(frame, 'sceneTitle'), \
            18, 28, 13, shbAccentColor, 'start', true), \
        shbSvgText(status, width - 18, 28, 12, shbTextDim, 'end', false) \
    ]
    telemetry = shbFilmTelemetry(frame)
    if width >= 760 && telemetry != '':
        arrayPush(hud, shbSvgText(telemetry, width / 2, 28, 13, shbTextColor, 'middle', true))
    endif

    # The timeline
    duration = cinemaDuration(shbReel)
    trackY = height - letterboxBottom + 8
    trackWidth = width - 36
    arrayPush(hud, \
        {'svg': 'rect', 'attr': {'x': 18, 'y': trackY, 'width': trackWidth, 'height': 3, 'fill': 'rgba(127,216,255,0.2)'}}, \
        {'svg': 'rect', 'attr': {'x': 18, 'y': trackY, 'width': shbRound(trackWidth * objectGet(frame, 'time') / duration), \
            'height': 3, 'fill': shbAccentColor}} \
    )
    sceneIndex = 1
    while sceneIndex < sceneCount:
        arrayPush(hud, {'svg': 'rect', 'attr': {'x': shbRound(18 + trackWidth * cinemaSceneStart(shbReel, sceneIndex) / duration), \
            'y': trackY - 3, 'width': 2, 'height': 9, 'fill': shbTextDim}})
        sceneIndex = sceneIndex + 1
    endwhile
    return {'svg': 'g', 'elem': hud}
endfunction


# The film's telemetry text - the countdown clock, the voyage's relativity, or the months in orbit - empty when
# there's none
function shbFilmTelemetry(frame):
    scene = objectGet(frame, 'scene')
    sceneTime = objectGet(frame, 'sceneTime')
    if scene == 'countdown':
        seconds = mathCeil(objectGet(frame, 'sceneDuration') - sceneTime)
        return 'T-00:00:' + if(seconds < 10, '0', '') + seconds
    elif scene == 'outbound' || scene == 'homeward':
        missionState = shbFilmVoyageState(frame)
        return 'v ' + numberToFixed(objectGet(missionState, 'beta'), 3) + ' c · γ ' + \
            numberToFixed(objectGet(missionState, 'gamma'), 2) + ' · ship ' + numberToFixed(objectGet(missionState, 'tau'), 2) + \
            ' yr · Earth ' + numberToFixed(objectGet(missionState, 't'), 2) + ' yr'
    elif scene == 'alpha':
        return 'Month ' + mathMax(1, mathCeil(sceneTime / objectGet(frame, 'sceneDuration') * shbSurveyMonths)) + ' of ' + \
            shbSurveyMonths + ' in orbit'
    endif
    return ''
endfunction
