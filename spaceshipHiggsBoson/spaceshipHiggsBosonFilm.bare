# Spaceship Higgs-Boson film - the voyage of the ISV Scalar Dawn, in the cinema model, and its sets and cast
#
# The film's sets, each with its own coordinates:
#
# - earthClose - the ship at the origin, heading +x, in a 400 km orbit over a 1:1000 scale Earth (so the view from the
#   ship matches a real orbit), with the Earth's surface 37.7 units below. Its lighting setups are "sunrise" (the sun
#   rising over the horizon ahead) and "day".
# - earthWide - the Earth at the origin, with the ship (enlarged) in a 400 km orbit
# - voyage - the ship at the origin, traveling +x from its origin body behind to its destination ahead
# - alphaClose - the ship at the origin over the gas giant Alpha Centauri Ab, which fills the sky
# - alphaWide - Alpha Centauri Ab at the origin, with the ship (enlarged) in orbit
# - end - the stars
#
# The ship's beats are "assemble" (its modules fly in and dock), "bubble" (the mass-suppression bubble forms),
# "ignite" (the drive fires), and "turnover" (the ship flips to decelerate).

include 'spaceshipHiggsBosonCinema.bare'
include 'spaceshipHiggsBosonModels.bare'


# The Earth close-up set's Earth radius and the ship's altitude above it, in set units - a 400 km orbit at 1:1000
shbCloseEarthRadius = 600
shbCloseAltitude = shbCloseEarthRadius * shbOrbitAltitudeKm / shbEarthRadiusKm


# The wide sets' orbits - the Earth's display radius plus 400 km, and the gas giant's radius and orbit radius
shbWideOrbitRadius = shbEarthDisplayRadius * (shbEarthRadiusKm + shbOrbitAltitudeKm) / shbEarthRadiusKm
shbGiantRadius = 30
shbGiantOrbitRadius = 36


# The ship's modules fly in to dock from these offsets, in assembly order
shbAssemblyOffsets = [[0, -16, 0], [18, 0, 0], [0, 16, 0], [0, 0, 16], [0, 0, -16], [-16, 8, 0], [-20, 0, 0]]


# The ship's blocking - on its mark at the origin, or in orbit on a wide set (enlarged)
shbShipOnMark = {'type': 'mark'}
shbShipInEarthOrbit = {'type': 'orbit', 'center': [0, 0, 0], 'radius': shbWideOrbitRadius, 'period': 32}
shbShipInGiantOrbit = {'type': 'orbit', 'center': [0, 0, 0], 'radius': shbGiantOrbitRadius, 'period': 20, 'inclination': -28.65}
shbShipEnlarged = shbShipName + ' (enlarged)'


# The wide Earth orbit camera - it orbits above the Earth between two angles, following the ship along the near side
# of its orbit
function shbEarthWideCamera(angle, angleEnd):
    return {'move': 'orbit', 'ease': 'linear', 'center': [0, -1, 0], 'radius': 17.34, 'height': 13.54, 'angle': angle, \
        'angleEnd': angleEnd}
endfunction


# The voyages' camera setup looking back past the ship at its departure, and their shots alongside and looking ahead
# past the ship to its destination
shbVoyageDeparture = {'move': 'dolly', 'eye': [15, 3, 11], 'eyeEnd': [9, 1.5, 7], 'target': [-6, -0.5, 0], 'targetEnd': [-5, -0.5, 0]}
shbVoyageAlongside = {'duration': 15, 'framing': 'wide', 'set': 'voyage', 'fadeIn': 0.5, 'camera': \
    {'move': 'dolly', 'eye': [-8, 9, 25], 'eyeEnd': [9, 4, 22], 'target': [3, 0, 0], 'targetEnd': [1, 0, 0]}}
shbVoyageAhead = {'duration': 14, 'framing': 'overTheShoulder', 'set': 'voyage', 'fadeIn': 0.5, 'camera': \
    {'move': 'dolly', 'eye': [-17, 4, -11], 'eyeEnd': [-11, 2.5, -8], 'target': [8, 0, 0], 'targetEnd': [8, 0.5, 0]}}


# The voyages' cast - the ship fires its drive, and flips at the midpoint to decelerate
shbVoyageCast = [{'name': 'ship', 'blocking': shbShipOnMark, 'beats': [{'at': 0, 'name': 'ignite'}, {'at': 18, 'name': 'turnover'}]}]


