# Spaceship Higgs-Boson models - the detail levels and the meshes of the ship, the Earth, the gas giant Alpha
# Centauri Ab, and the starfield, and the scene objects built from them

include 'spaceshipHiggsBosonPhysics.bare'
include 'spaceshipHiggsBosonRender.bare'


# The rendering detail levels - "fps" is the level's frame rate target, and "faces" is the approximate face count of
# a frame
shbQualityLevels = [ \
    { \
        'name': 'Low', 'fps': 12, 'faces': 2000, 'bandStep': 4, 'stars': 300, 'earthBands': 20, 'earthSegments': 40, 'clouds': false, \
        'cities': false, 'specular': false, 'segments': 10, 'ringMajor': 18, 'ringMinor': 4, 'sphereBands': 5, \
        'sphereSegments': 8, 'shipDetail': false, 'particles': 0, 'glow': false \
    }, \
    { \
        'name': 'Medium', 'fps': 10, 'faces': 3800, 'bandStep': 3, 'stars': 600, 'earthBands': 28, 'earthSegments': 56, 'clouds': false, \
        'cities': true, 'specular': true, 'segments': 14, 'ringMajor': 24, 'ringMinor': 6, 'sphereBands': 6, \
        'sphereSegments': 12, 'shipDetail': true, 'particles': 12, 'glow': false \
    }, \
    { \
        'name': 'High', 'fps': 8, 'faces': 7500, 'bandStep': 2.5, 'stars': 1000, 'earthBands': 36, 'earthSegments': 72, 'clouds': true, \
        'cities': true, 'specular': true, 'segments': 18, 'ringMajor': 32, 'ringMinor': 8, 'sphereBands': 8, \
        'sphereSegments': 16, 'shipDetail': true, 'particles': 24, 'glow': true \
    }, \
    { \
        'name': 'Ultra', 'fps': 7, 'faces': 10500, 'bandStep': 2, 'stars': 1600, 'earthBands': 44, 'earthSegments': 88, 'clouds': true, \
        'cities': true, 'specular': true, 'segments': 24, 'ringMajor': 48, 'ringMinor': 10, 'sphereBands': 10, \
        'sphereSegments': 20, 'shipDetail': true, 'particles': 40, 'glow': true \
    } \
]


# The Earth's display radius and its turning rate (radians per second)
shbEarthDisplayRadius = 6
shbEarthSpin = 2 * shbPi / 90


# The viewer's default camera angles (degrees)
shbViewerYaw = 30
shbViewerPitch = 22


# The ship component labels and their anchor points (ship coordinates)
shbShipLabels = [ \
    {'text': 'Command module', 'point': [4.6, 0.8, 0]}, \
    {'text': 'Higgs factory ring', 'point': [1.4, 3, 0]}, \
    {'text': 'Radiators', 'point': [-0.8, 0, 3.3]}, \
    {'text': 'Higgs decay chamber', 'point': [-3.4, -1.1, 0]}, \
    {'text': 'Magnetic nozzle', 'point': [-6.6, 1.7, 0]}, \
    {'text': 'Mass-suppression bubble', 'point': [0, -3.8, 0]} \
]


# The ship viewer scene for a camera state ("yaw", "pitch", "zoom", "spin", "time", "drive", and "labels")
function shbViewerScene(state, level, width, height):
    quality = arrayGet(shbQualityLevels, level)
    camera = shbCamera(state, [0, 0, 0], 24, width, height)
    scene = shbSceneNew(camera, [-0.45, 0.6, -0.65])
    shbSceneAddStarfield(scene, quality, 0)
    shipMatrix = shbMatRotY(objectGet(state, 'spin') * shbDeg)
    driveOn = objectGet(state, 'drive')
    shbSceneAddShip(scene, shbMeshes(level), quality, shipMatrix, [0, 0, 0], objectGet(state, 'time'), driveOn, driveOn)
    if objectGet(state, 'labels'):
        for label in shbShipLabels:
            shbSceneAddLabel(scene, shbMatApply(shipMatrix, objectGet(label, 'point')), objectGet(label, 'text'))
        endfor
    endif
    return scene
endfunction


# Add the Earth, its clouds, and its atmosphere to a scene, scaled from its display radius
function shbSceneAddEarth(scene, meshes, position, time, scale):
    radius = shbEarthDisplayRadius * scale
    shbSceneAddGlow(scene, position, radius * 1.13, 'url(#shbAtmosphere)', radius)
    shbSceneAddMesh(scene, objectGet(meshes, 'earth'), shbMatScale(shbMatRotY(time * shbEarthSpin), scale), position)
    clouds = objectGet(meshes, 'clouds')
    if clouds != null:
        shbSceneAddMesh(scene, clouds, shbMatScale(shbMatRotY(time * shbEarthSpin * 1.3), scale), position)
    endif
    shbSceneAddGlow(scene, position, radius * 1.02, 'url(#shbHaze)', -radius * 0.98)
endfunction


# Add the atmosphere's glow along a planet's horizon, as seen from an eye point, to a scene
function shbSceneAddHorizon(scene, center, radius, eye, glowFilter):
    toEye = shbVecSub(eye, center)
    distance = shbVecLength(toEye)
    ratio = radius / distance
    circleCenter = shbVecAdd(center, shbVecScale(toEye, ratio * ratio))
    circleRadius = radius * mathSqrt(1 - ratio * ratio)
    axisA = shbVecNormalize(shbVecCross(toEye, [0, 0, 1]))
    axisB = shbVecNormalize(shbVecCross(toEye, axisA))
    points = []
    segment = 0
    while segment < 120:
        angle = segment * 3 * shbDeg
        arrayPush(points, shbVecAdd(circleCenter, shbVecAdd(shbVecScale(axisA, circleRadius * mathCos(angle)), \
            shbVecScale(axisB, circleRadius * mathSin(angle)))))
        segment = segment + 1
    endwhile
    depthOffset = -0.15 * radius
    shbSceneAddPath(scene, points, 'rgba(90,150,255,0.35)', 16, 'none', false, glowFilter, null, depthOffset)
    shbSceneAddPath(scene, points, 'rgba(150,205,255,0.9)', 3, 'none', false, null, null, depthOffset)
endfunction


# Add the ship to a scene - with its mass-suppression bubble and particles, and its exhaust plume
function shbSceneAddShip(scene, meshes, quality, matrix, position, time, bubbleOn, plumeOn):
    shbSceneAddMesh(scene, objectGet(meshes, 'ship'), matrix, position)
    glowFilter = if(objectGet(quality, 'glow'), 'url(#shbGlow)', null)

    # The Higgs factory ring's glow
    ringPoints = []
    segment = 0
    while segment < 24:
        angle = segment * 15 * shbDeg
        arrayPush(ringPoints, shbVecAdd(shbMatApply(matrix, [1.4, 2.7 * mathCos(angle), 2.7 * mathSin(angle)]), position))
        segment = segment + 1
    endwhile
    pulse = 0.5 + 0.5 * mathSin(time * 4)
    shbSceneAddPath(scene, ringPoints, 'rgba(120,230,255,' + numberToFixed(0.15 + 0.2 * pulse, 2) + ')', \
        3 + 2 * pulse, 'none', false, glowFilter)

    # Exhaust plume and engine glow
    if plumeOn:
        shbSceneAddMesh(scene, objectGet(meshes, 'plume'), matrix, position)
        shbSceneAddGlow(scene, shbVecAdd(shbMatApply(matrix, [-6.9, 0, 0]), position), 2.6, 'url(#shbEngine)', -0.5)
    endif
    if !bubbleOn:
        return
    endif

    # Mass-suppression bubble field lines
    bubblePulse = 1 + 0.03 * mathSin(time * 3)
    radiusX = 8.4 * bubblePulse
    radius = 3.8 * bubblePulse
    rings = [[], [], [], []]
    segment = 0
    while segment < 32:
        angle = segment * 11.25 * shbDeg
        cosAngle = mathCos(angle)
        sinAngle = mathSin(angle)
        for ring, ixRing in arraySlice(rings, 0, 3):
            meridian = ixRing * 60 * shbDeg
            arrayPush(ring, shbVecAdd(shbMatApply(matrix, \
                [radiusX * cosAngle, radius * sinAngle * mathCos(meridian), radius * sinAngle * mathSin(meridian)]), position))
        endfor
        arrayPush(arrayGet(rings, 3), shbVecAdd(shbMatApply(matrix, [0, radius * cosAngle, radius * sinAngle]), position))
        segment = segment + 1
    endwhile
    dashOffset = numberToFixed((time * 24) % 14, 1)
    for ring in rings:
        shbSceneAddPath(scene, ring, 'rgba(120,220,255,0.4)', 1, '4 3', false, null, dashOffset)
    endfor

    # Higgs bosons streaming along the bubble's meridians
    particleCount = objectGet(quality, 'particles')
    particle = 0
    while particle < particleCount:
        meridian = (particle % 3) * 60 * shbDeg
        angle = 2 * shbPi * ((time * 0.15 + particle / particleCount) % 1)
        point = [radiusX * mathCos(angle), radius * mathSin(angle) * mathCos(meridian), radius * mathSin(angle) * mathSin(meridian)]
        shbSceneAddGlow(scene, shbVecAdd(shbMatApply(matrix, point), position), 0.22, 'url(#shbParticle)', 0)
        particle = particle + 1
    endwhile
endfunction


